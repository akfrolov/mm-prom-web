DirectoryIndex index.html
ErrorDocument 404 /404.html

AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .mjs .json .xml .svg .txt
</IfModule>

ServerSignature Off
<IfModule mod_headers.c>
  Header always unset Server
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www -> без www
  RewriteCond %{HTTP_HOST} ^www\.mm-prom\.ru$ [NC]
  RewriteRule ^ https://mm-prom.ru%{REQUEST_URI} [R=301,L]

  # 301-карта дублей WordPress
  Redirect 301 /garage/ /atlas-garazhnyj/
  Redirect 301 /ga/ /atlas-garazhnyj/
  Redirect 301 /vitebski/ /avrora-vitebskij/
  Redirect 301 /avrora-vitebskij-3/ /avrora-vitebskij/
  Redirect 301 /sitemap.html /

  # Канонический слэш на конце directory-URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

# Кеш статики: изображения, шрифты, CSS/JS. URL версионируются (?v=) или
# хешируются Astro (/_astro/), поэтому годовой max-age безопасен. HTML не
# кешируем, чтобы правки контента подхватывались сразу.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
