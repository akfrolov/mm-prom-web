                  <a href="/arenda/">Аренда недвижимости</a>
                  <a href="/prodazha/">Продажа недвижимости</a>
                  <a href="/trade-in/">Трейд-ин / Срочный выкуп</a>
                  <a href="/stroitelstvo/">Строительство</a>
                  <a href="/development/">Девелопмент под ключ</a>
                  <a href="/redevelopment/">Редевелопмент</a>
                  <a href="/consalting/">Промышленный консалтинг</a>
                  <a href="/investcomp/">Инвестиции и финансирование</a>
                  <a class="mobile-menu__more" href="/sobstvennikam-uchastkov/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
                </div>
                <button class="mobile-menu__role" type="button" data-mrole="invest" aria-expanded="false">Инвесторам<span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
