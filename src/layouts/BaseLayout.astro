---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** OG-изображение страницы: относительный или абсолютный URL. Дефолт — логотип. */
  ogImage?: string;
  /** OG-тип страницы. Дефолт — website; статьи передают article. */
  ogType?: string;
}

const { title, description, noindex = false, ogImage: ogImageProp, ogType = 'website' } = Astro.props;
const isProd = process.env.MMPROM_ENV !== 'staging';
const site = Astro.site ?? new URL('https://mm-prom.ru');
const canonical = new URL(Astro.url.pathname, site).href;
const robots = !isProd || noindex ? 'noindex, follow' : 'index, follow';
const ogImage = ogImageProp ? new URL(ogImageProp, site).href : new URL('/mmprom-logo.png', site).href;
const metrika = `<script>
(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
ym(109764749, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/109764749" style="position:absolute; left:-9999px;" alt="" /></div></noscript>`;
---
<!doctype html>
