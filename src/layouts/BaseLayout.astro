                </div>
                <div class="mm-item" data-roles="prod zdaniya uchastki investor">
                  <a class="mm-item__main" href="/investcomp/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></span>
                    <span class="mm-item__body">
