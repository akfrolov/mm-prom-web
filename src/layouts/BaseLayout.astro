    <!-- ═══ Мегаменю «Услуги»: центрированный оверлей (≥1024, W2.1) ═══ -->
    <div class="mega-overlay" id="mega-overlay" hidden>
      <div class="mega-overlay__backdrop" data-mega-close></div>
      <div class="mega-overlay__holder">
