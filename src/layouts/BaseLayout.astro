---
import B24Loader from '../components/B24Loader.astro';
import { B24_FORMS } from '../lib/b24';
import { Font } from 'astro:assets';
import commonCss from '../styles/common.css?url';
import baseCss from '../styles/base.css?raw';
import blocksCss from '../styles/blocks.css?raw';
import animCss from '../styles/site-anim.css?raw';
import heroCss from '../styles/hero.css?raw';
import mobileCss from '../styles/site-mobile.css?raw';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** OG-изображение страницы: относительный или абсолютный URL. Дефолт — логотип. */
  ogImage?: string;
  /** OG-тип страницы. Дефолт — website; статьи передают article. */
  ogType?: string;
}

const { title, description, noindex = false, ogImage: ogImageProp, ogType = 'website' } = Astro.props;
const isProd = process.env.MMPROM_ENV !== 'staging';
const site = Astro.site ?? new URL('https://mm-prom.ru');
const canonical = new URL(Astro.url.pathname, site).href;
const robots = !isProd || noindex ? 'noindex, follow' : 'index, follow';
const ogImageRaw = ogImageProp ? new URL(ogImageProp, site).href : new URL('/mmprom-logo.png', site).href;
const ogImage = ogImageRaw.replace(/\.(webp|avif)$/i, '.jpg');
const metrika = `<script>
(function(){
  var started = false;
  function init() {
    if (started) return;
    started = true;
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
    ym(109764749, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
  }
  var events = ["pointerdown", "keydown", "wheel", "touchstart", "scroll"];
  function onIntent() {
    events.forEach(function (e) { window.removeEventListener(e, onIntent); });
    init();
  }
  events.forEach(function (e) { window.addEventListener(e, onIntent, { once: true, passive: true }); });
  setTimeout(init, 15000);
})();
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/109764749" style="position:absolute; left:-9999px;" alt="" /></div></noscript>`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script is:inline>
      document.addEventListener('error', function (e) {
        var img = e.target;
        if (!img || img.tagName !== 'IMG' || img.dataset.fb) return;
        if (img.src.indexOf('/_astro/') !== -1) return;
        if (!/\.(webp|avif)(?=\?|$)/.test(img.src)) return;
        e.stopPropagation();
        img.dataset.fb = '1';
        img.src = img.src.replace(/\.(webp|avif)(?=\?|$)/, '.jpg');
      }, true);
    </script>
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content={robots}>
    <link rel="icon" type="image/png" href="/mm-logo.png">
    <link rel="apple-touch-icon" sizes="116x116" href="/mm-logo.png">
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content="ММ Пром">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:locale" content="ru_RU">
    <Font
      cssVariable="--font-manrope"
      preload={[
        { subset: 'cyrillic', weight: 400 },
        { subset: 'latin', weight: 400 },
        { subset: 'cyrillic', weight: 800 },
      ]}
    />
    <Font cssVariable="--font-inter" />
    <link rel="preload" href="/assets/fonts/material-symbols-outlined.woff2?v=2" as="font" type="font/woff2" crossorigin>
    {import.meta.env.DEV ? (
      <Fragment>
        <style is:inline set:html={baseCss}></style>
        <style is:inline set:html={blocksCss}></style>
        <style is:inline set:html={animCss}></style>
      </Fragment>
    ) : (
      <link rel="stylesheet" href={commonCss}>
    )}
    <slot name="head" />
    <style is:inline set:html={heroCss}></style>
    <style is:inline set:html={mobileCss}></style>
    {isProd && <Fragment set:html={metrika} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__logo" href="/">
          <img src="/mmprom-logo-1x.png?v=1" srcset="/mmprom-logo-1x.png?v=1 1x, /mmprom-logo.png?v=1 2x" width="201" height="58" alt="ММ Пром">
        </a>
        <nav class="site-header__nav" aria-label="Основное меню">
          <div class="nav-item nav-item--has-mega">
            <button class="site-header__mega-trigger" id="mega-trigger" type="button" aria-haspopup="dialog" aria-controls="mega-overlay" aria-expanded="false">Услуги<span class="material-symbols-outlined site-header__mega-chevron" aria-hidden="true">expand_more</span></button>
          </div>
          <a href="/katalog/" data-astro-prefetch>Каталог</a>
          <a href="/blog/" data-astro-prefetch>Публикации</a>
          <a href="/about/" data-astro-prefetch>О компании</a>
          <a href="/contact/" data-astro-prefetch>Контакты</a>
        </nav>
        <div class="site-header__actions">
          <a class="site-header__phone" href="tel:88003331010"><span class="visually-hidden">Телефон: </span>8 800 333 10 10</a>
          <B24Loader form="request" />
          <button class="btn btn--purple site-header__cta" type="button" data-b24-form="click/36/skk415" data-b24-form-telemetry-sign="v1:36:site.a467aeed9d7582f9de1e8a4dfb29aea466dae483b5806ff9c02b839525a9d495" data-b24-loader={B24_FORMS.request.loader}>Оставить заявку</button>
          <button class="site-header__burger" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu"><span class="material-symbols-outlined" aria-hidden="true">menu</span></button>
        </div>
      </div>
    </header>

    <!-- ═══ Мобильное меню: drawer справа (W2.2) ═══ -->
    <div class="mobile-overlay" id="mobile-overlay" hidden>
      <div class="mobile-overlay__backdrop" data-mobile-close></div>
      <div class="mobile-overlay__holder">
        <section class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Мобильное меню">
          <div class="mobile-menu__bar">
            <button class="mobile-menu__close" type="button" aria-label="Закрыть меню" data-mobile-close><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
          </div>
          <nav class="mobile-menu__nav" aria-label="Мобильное меню">
            <div class="mobile-menu__item">
              <div class="mobile-menu__heading">
                <span class="mobile-menu__toggle-name"><span class="material-symbols-outlined" aria-hidden="true">widgets</span>Услуги</span>
              </div>
              <div class="mobile-menu__sub is-open">
                <button class="mobile-menu__role" type="button" data-mrole="prod" aria-expanded="false">Производствам<span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
                <div class="mobile-menu__services" data-mpanel="prod">
                  <a href="/brokerage/">Подбор недвижимости</a>
                  <a href="/arenda/">Аренда недвижимости</a>
                  <a href="/trade-in/">Трейд-ин / Срочный выкуп</a>
                  <a href="/stroitelstvo/">Строительство</a>
                  <a href="/development/">Девелопмент под ключ</a>
                  <a href="/redevelopment/">Редевелопмент</a>
                  <a href="/upravlenie/">Управление</a>
                  <a href="/consalting/">Промышленный консалтинг</a>
                  <a href="/investoram/">Инвестиции и финансирование</a>
                  <a class="mobile-menu__more" href="/proizvodstvam/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
                </div>
                <button class="mobile-menu__role" type="button" data-mrole="zdaniya" aria-expanded="false">Собственникам зданий<span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
                <div class="mobile-menu__services" data-mpanel="zdaniya">
                  <a href="/brokerage/">Подбор недвижимости</a>
                  <a href="/arenda/">Аренда недвижимости</a>
                  <a href="/prodazha/">Продажа недвижимости</a>
                  <a href="/trade-in/">Трейд-ин / Срочный выкуп</a>
                  <a href="/redevelopment/">Редевелопмент</a>
                  <a href="/upravlenie/">Управление</a>
                  <a href="/consalting/">Промышленный консалтинг</a>
                  <a href="/investoram/">Инвестиции и финансирование</a>
                  <a class="mobile-menu__more" href="/sobstvennikam-zdaniy/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
                </div>
                <button class="mobile-menu__role" type="button" data-mrole="uchastki" aria-expanded="false">Собственникам участков<span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
                <div class="mobile-menu__services" data-mpanel="uchastki">
                  <a href="/brokerage/">Подбор недвижимости</a>
                  <a href="/arenda/">Аренда недвижимости</a>
                  <a href="/prodazha/">Продажа недвижимости</a>
                  <a href="/trade-in/">Трейд-ин / Срочный выкуп</a>
                  <a href="/stroitelstvo/">Строительство</a>
                  <a href="/development/">Девелопмент под ключ</a>
                  <a href="/redevelopment/">Редевелопмент</a>
                  <a href="/consalting/">Промышленный консалтинг</a>
                  <a href="/investoram/">Инвестиции и финансирование</a>
                  <a class="mobile-menu__more" href="/sobstvennikam-uchastkov/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
                </div>
                <button class="mobile-menu__role" type="button" data-mrole="invest" aria-expanded="false">Инвесторам<span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
                <div class="mobile-menu__services" data-mpanel="invest">
                  <a href="/brokerage/">Подбор недвижимости</a>
                  <a href="/upravlenie/">Управление активом</a>
                  <a href="/consalting/">Промышленный консалтинг</a>
                  <a class="mobile-menu__more" href="/investoram/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
                </div>
              </div>
            </div>
            <a class="mobile-menu__link" href="/katalog/" data-astro-prefetch><span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>Каталог</a>
            <a class="mobile-menu__link" href="/blog/" data-astro-prefetch><span class="material-symbols-outlined" aria-hidden="true">article</span>Публикации</a>
            <a class="mobile-menu__link" href="/about/" data-astro-prefetch><span class="material-symbols-outlined" aria-hidden="true">apartment</span>О компании</a>
            <a class="mobile-menu__link" href="/contact/" data-astro-prefetch><span class="material-symbols-outlined" aria-hidden="true">place</span>Контакты</a>
          </nav>
          <div class="mobile-menu__actions">
            <a class="site-header__phone" href="tel:88003331010"><span class="visually-hidden">Позвонить: </span>8 800 333 10 10</a>
            <B24Loader form="request" />
            <button class="btn btn--purple" type="button" data-b24-form="click/36/skk415" data-b24-form-telemetry-sign="v1:36:site.a467aeed9d7582f9de1e8a4dfb29aea466dae483b5806ff9c02b839525a9d495" data-b24-loader={B24_FORMS.request.loader}>Оставить заявку</button>
          </div>
        </section>
      </div>
    </div>

    <!-- ═══ Мегаменю «Услуги»: центрированный оверлей (≥1024, W2.1) ═══ -->
    <div class="mega-overlay" id="mega-overlay" hidden>
      <div class="mega-overlay__backdrop" data-mega-close></div>
      <div class="mega-overlay__holder">
        <section class="mega-panel" role="dialog" aria-modal="true" aria-label="Меню «Услуги»">
          <button class="mega-panel__close" type="button" aria-label="Закрыть меню" data-mega-close><span class="material-symbols-outlined" aria-hidden="true">close</span></button>

          <!-- Вкладки ролей (слева) + группы услуг (справа). Радио-фильтр без JS:
               скрытые radio управляют подсветкой вкладки, чипом-заголовком и
               фильтрацией услуг (CSS-фильтр по data-roles). -->
          <div class="mm-layout">
            <p class="mm-roles-title">Решения под вашу задачу</p>

            <input class="mm-tab-radio" type="radio" name="mm-role" id="mmf-all" checked>

            <input class="mm-tab-radio" type="radio" name="mm-role" id="mmf-prod">
            <div class="mm-tab">
              <label class="mm-tab__label" for="mmf-prod"><span class="material-symbols-outlined mm-tab__icon" aria-hidden="true">factory</span><span class="mm-tab__name">Производствам</span></label>
              <label class="mm-tab__body" for="mmf-prod"><span class="mm-tab__desc">Продажа/аренда помещений; строительство; инвестиции и финансирование</span></label>
              <a class="mm-tab__more" href="/proizvodstvam/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
            </div>

            <input class="mm-tab-radio" type="radio" name="mm-role" id="mmf-zdaniya">
            <div class="mm-tab">
              <label class="mm-tab__label" for="mmf-zdaniya"><span class="material-symbols-outlined mm-tab__icon" aria-hidden="true">apartment</span><span class="mm-tab__name">Собственникам зданий</span></label>
              <label class="mm-tab__body" for="mmf-zdaniya"><span class="mm-tab__desc">Управление объектом и повышение доходности; продажа и сдача в аренду; редевелопмент объекта.</span></label>
              <a class="mm-tab__more" href="/sobstvennikam-zdaniy/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
            </div>

            <input class="mm-tab-radio" type="radio" name="mm-role" id="mmf-uchastki">
            <div class="mm-tab">
              <label class="mm-tab__label" for="mmf-uchastki"><span class="material-symbols-outlined mm-tab__icon" aria-hidden="true">landscape</span><span class="mm-tab__name">Собственникам участков</span></label>
              <label class="mm-tab__body" for="mmf-uchastki"><span class="mm-tab__desc">Аренда/продажа участка; консалтинг по повышению доходности; строительство объектов.</span></label>
              <a class="mm-tab__more" href="/sobstvennikam-uchastkov/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
            </div>

            <input class="mm-tab-radio" type="radio" name="mm-role" id="mmf-investor">
            <div class="mm-tab mm-tab--last">
              <label class="mm-tab__label" for="mmf-investor"><span class="material-symbols-outlined mm-tab__icon" aria-hidden="true">trending_up</span><span class="mm-tab__name">Инвесторам</span></label>
              <label class="mm-tab__body" for="mmf-investor"><span class="mm-tab__desc">Объекты для инвестиций, консалтинг.</span></label>
              <a class="mm-tab__more" href="/investoram/">Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
            </div>

            <!-- Заголовок-чип правой области: отдельный grid-элемент .mm-layout
                 (строка 1, колонка 2) — над группами услуг. 5 пред-рендеренных
                 состояний; при выборе роли — её чип с ✕-сбросом (label for=mmf-all). -->
            <div class="mm-head">
              <span class="mm-head__chip mm-head__chip--all">Все услуги</span>
              <span class="mm-head__chip mm-head__chip--prod">Услуги для производств<label class="mm-head__x" for="mmf-all" aria-label="Показать все услуги"><span class="material-symbols-outlined" aria-hidden="true">close</span></label></span>
              <span class="mm-head__chip mm-head__chip--zdaniya">Услуги для собственников зданий<label class="mm-head__x" for="mmf-all" aria-label="Показать все услуги"><span class="material-symbols-outlined" aria-hidden="true">close</span></label></span>
              <span class="mm-head__chip mm-head__chip--uchastki">Услуги для собственников участков<label class="mm-head__x" for="mmf-all" aria-label="Показать все услуги"><span class="material-symbols-outlined" aria-hidden="true">close</span></label></span>
              <span class="mm-head__chip mm-head__chip--investor">Услуги для инвесторов<label class="mm-head__x" for="mmf-all" aria-label="Показать все услуги"><span class="material-symbols-outlined" aria-hidden="true">close</span></label></span>
            </div>

            <!-- Единый каталог услуг: каждая услуга один раз, сгруппированы по смыслу.
                 data-roles — матрица «услуга × роль» (токены: prod zdaniya uchastki investor) -->
            <div class="mm-groups">
              <section class="mm-group" aria-labelledby="mm-g-objects">
                <h2 class="mm-group__title" id="mm-g-objects">Объекты</h2>
                <div class="mm-item" data-roles="prod zdaniya uchastki investor">
                  <a class="mm-item__main" href="/arenda/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">warehouse</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Аренда недвижимости</span>
                      <span class="mm-item__desc">Площади под производство, складские помещения.</span>
                    </span>
                  </a>
                </div>
                <div class="mm-item" data-roles="zdaniya uchastki investor">
                  <a class="mm-item__main" href="/prodazha/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">sell</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Продажа недвижимости</span>
                      <span class="mm-item__desc">Поиск покупателей на ваш объект.</span>
                    </span>
                  </a>
                </div>
                <div class="mm-item" data-roles="prod zdaniya uchastki investor">
                  <a class="mm-item__main" href="/trade-in/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">swap_horiz</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Трейд-ин / Срочный выкуп</span>
                      <span class="mm-item__desc">Обмен объекта на более эффективный формат или быстрая продажа актива.</span>
                    </span>
                  </a>
                </div>
              </section>

              <section class="mm-group" aria-labelledby="mm-g-projects">
                <h2 class="mm-group__title" id="mm-g-projects">Проекты и эксплуатация</h2>
                <div class="mm-item" data-roles="prod uchastki investor">
                  <a class="mm-item__main" href="/stroitelstvo/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">foundation</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Строительство</span>
                      <span class="mm-item__desc">Построим объект под задачи производства или для инвестиционных целей.</span>
                    </span>
                  </a>
                </div>
                <div class="mm-item" data-roles="prod uchastki investor">
                  <a class="mm-item__main" href="/development/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">construction</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Девелопмент под ключ</span>
                      <span class="mm-item__desc">Реализация промышленного проекта — от участка до запуска.</span>
                    </span>
                  </a>
                </div>
                <div class="mm-item" data-roles="prod zdaniya uchastki investor">
                  <a class="mm-item__main" href="/redevelopment/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">autorenew</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Редевелопмент</span>
                      <span class="mm-item__desc">Перестройка устаревшего объекта под новый эффективный формат.</span>
                    </span>
                  </a>
                </div>
                <div class="mm-item" data-roles="prod zdaniya investor">
                  <a class="mm-item__main" href="/upravlenie/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">settings</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Управление</span>
                      <span class="mm-item__desc">Эксплуатация и управление промышленными объектами.</span>
                    </span>
                  </a>
                </div>
              </section>

              <section class="mm-group" aria-labelledby="mm-g-strategy">
                <h2 class="mm-group__title" id="mm-g-strategy">Стратегия и капитал</h2>
                <div class="mm-item" data-roles="prod zdaniya uchastki">
                  <a class="mm-item__main" href="/consalting/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">insights</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Промышленный консалтинг</span>
                      <span class="mm-item__desc">Превращаем задачу в конкретный план по повышению доходности промышленного объекта.</span>
                    </span>
                  </a>
                </div>
                <div class="mm-item" data-roles="prod zdaniya uchastki">
                  <a class="mm-item__main" href="/investoram/">
                    <span class="mm-item__icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></span>
                    <span class="mm-item__body">
                      <span class="mm-item__name">Инвестиции и финансирование</span>
                      <span class="mm-item__desc">Инвестиции в реальные промышленные активы с понятной экономикой.</span>
                    </span>
                  </a>
                </div>
