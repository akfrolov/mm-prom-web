---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteButton from '../components/SiteButton.astro';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ARTICLE_CATEGORIES, articleCategoryLabel, formatArticleDate, readingMinutes } from '../lib/articles';

const articles = (await getCollection('articles'))
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    lead: entry.data.lead,
    date: entry.data.date,
    category: entry.data.category,
    categoryLabel: articleCategoryLabel(entry.data.category),
    cover: entry.data.cover as ImageMetadata,
    minutes: readingMinutes(entry.body),
  }))
  // Порядок: по дате убыв., материал без даты — последним (§2.4 п. 4).
  .sort((a, b) => {
    if (!a.date && !b.date) return a.title.localeCompare(b.title);
    if (!a.date) return 1;
    if (!b.date) return -1;
    return b.date.localeCompare(a.date);
  });
---

<BaseLayout title="Публикации — статьи и кейсы ММ Пром" description="Экспертные статьи и кейсы об индустриальной недвижимости.">
  <Fragment slot="head">
    <style is:inline>
    /* ═══ Страница «Публикации»: шапка раздела и лента статей ═══
       Общие блоки (section, section--tint, grid--3, b-cta, кнопки,
       крошки) — base.css/blocks.css; здесь только карточка публикации. */

    /* ── Шапка раздела: h1 + подводка (по макету docs/mockups/blog.html) ── */
    .b-filters{padding:clamp(28px,4vw,48px) 0 clamp(24px,3vw,40px)}
    .b-filters h1{margin-bottom:12px}
    .b-filters h1::after{content:"";display:block;width:64px;height:4px;border-radius:2px;background:var(--gold);margin-top:10px}
    .b-filters__lead{margin:0;max-width:70ch;color:var(--text-muted)}

    /* ── Рубрики и поиск (макет docs/mockups/blog.html, #filters) ───────── */
    .blog-toolbar{display:flex;flex-direction:column;gap:12px;margin:20px 0 0}
    .blog-cats{display:flex;flex-wrap:wrap;gap:8px}
    .blog-cats__tab{min-height:44px;padding:8px 16px;border:1px solid var(--border);border-radius:999px;background:#fff;color:var(--text-muted);font:inherit;font-size:var(--fs-small);font-weight:700;cursor:pointer;white-space:nowrap}
    .blog-cats__tab:hover{border-color:var(--purple);color:var(--purple)}
    .blog-cats__tab.is-active{border-color:var(--purple-soft);background:var(--purple-soft);color:var(--purple)}
    .blog-search{display:flex}
    .search-box{position:relative;flex:1 1 auto}
    .search-box__ico{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:20px;color:var(--text-muted);pointer-events:none}
    .search-box input[type="search"]{width:100%;min-height:44px;padding:10px 16px 10px 44px;border:2px solid var(--border);border-radius:var(--radius);font:inherit;font-size:var(--fs-small);color:var(--text);background:#fff}
    .search-box input[type="search"]:focus-visible{outline:3px solid rgba(90,57,148,.22);outline-offset:1px;border-color:var(--purple)}
    .search-box input[type="search"]::placeholder{color:var(--text-muted);opacity:.7}
    .sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    @media (min-width:768px){
      .blog-toolbar{flex-direction:row;flex-wrap:nowrap;align-items:center;gap:12px 24px}
      .blog-cats{flex:1 1 auto;min-width:0}
      .blog-search{flex:0 0 clamp(220px,20vw,300px)}
    }

    /* ── Карточка публикации (канон .post-card макета) ──────────────────── */
    .post-card{position:relative;display:flex;flex-direction:column;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:border-color .22s ease,box-shadow .22s ease,transform .22s ease}
    .post-card[hidden]{display:none}
    .post-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .post-card:focus-within{outline:2px solid var(--purple);outline-offset:2px}
    .post-card__media{position:relative;flex:0 0 auto;aspect-ratio:4/3;background:var(--surface);border-bottom:1px solid var(--border);overflow:hidden}
    .post-card__media img{width:100%;height:100%;object-fit:cover;display:block}
    .post-card__body{display:flex;flex-direction:column;gap:8px;padding:18px;flex:1 1 auto}
    .post-card__tags{display:flex;flex-wrap:wrap;gap:8px}
    .tag{display:inline-flex;align-items:center;min-height:24px;padding:2px 10px;border-radius:999px;background:rgba(90,57,148,.08);color:var(--purple);font-size:var(--fs-small);font-weight:600}
    .tag--cases{background:rgba(201,150,15,.14);color:var(--gold-deep)}
    .tag--news{background:rgba(235,184,30,.18);color:var(--navy)}
    .post-card__body h3{margin:0;font-size:1.0625rem;line-height:1.35}
    /* Вся карточка кликабельна: ссылка заголовка растянута на карточку */
    .post-card__body h3 a{color:var(--text);text-decoration:none}
    .post-card__body h3 a::after{content:"";position:absolute;inset:0;z-index:1;border-radius:inherit}
    .post-card:hover .post-card__body h3 a{color:var(--purple)}
    .post-card__body h3 a:focus-visible{outline:none}
    .post-card__excerpt{margin:0;font-size:var(--fs-small);color:var(--text-muted)}
    .post-card__meta{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:auto;padding-top:12px;border-top:1px solid var(--border);font-size:var(--fs-small);color:var(--text-muted)}
    .post-card__meta span{display:inline-flex;align-items:center;gap:6px}
    .post-card__meta .material-symbols-outlined{font-size:16px;color:var(--purple)}

    /* ── Reveal-анимации (как на других страницах) ──────────────────────── */
    html.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .45s ease,transform .45s ease}
    html.js .reveal.is-visible{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){
      html.js .reveal{opacity:1;transform:none;transition:none}
    }

    /* ── Пустое состояние поиска и фильтра ─────────────────────────────── */
    .b-empty{display:none;flex-direction:column;align-items:center;gap:8px;padding:48px 16px;text-align:center;color:var(--text-muted)}
    .b-empty .material-symbols-outlined{font-size:40px;color:var(--border)}
    .b-empty.is-visible{display:flex}
    </style>
  </Fragment>

<main>

  <Breadcrumbs items={[{ href: "/", label: "Главная" }, { label: "Публикации" }]} />

  <section id="filters" class="b-filters">
    <div class="container">
      <h1>Статьи и кейсы</h1>
      <p class="b-filters__lead">Экспертные статьи и кейсы об индустриальной недвижимости</p>
      <div class="blog-toolbar">
        <div class="blog-cats" role="tablist" aria-label="Рубрики публикаций">
          {ARTICLE_CATEGORIES.map((category) => (
            <button
              type="button"
              role="tab"
              class:list={["blog-cats__tab", category.id === "all" && "is-active"]}
              data-category={category.id}
              aria-selected={category.id === "all" ? "true" : "false"}
              aria-controls="feed"
            >{category.label}</button>
          ))}
        </div>
        <form class="blog-search" action="#" role="search">
          <div class="search-box">
            <span class="material-symbols-outlined search-box__ico" aria-hidden="true">search</span>
            <label class="sr-only" for="blog-q">Поиск по публикациям</label>
            <input id="blog-q" name="q" type="search" placeholder="Поиск по статьям и кейсам" autocomplete="off">
          </div>
        </form>
      </div>
    </div>
  </section>

  <section id="feed" class="section section--tint">
    <div class="container">
      <div class="grid grid--3">
        {articles.map((article) => (
          <article class="post-card reveal" data-category={article.category}>
            <div class="post-card__media">
              <Image
                src={article.cover}
                widths={[400, 640, 960]}
                sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
                alt={`Обложка: ${article.title}`}
              />
            </div>
            <div class="post-card__body">
              <div class="post-card__tags">
                <span class:list={["tag", `tag--${article.category}`]}>{article.categoryLabel}</span>
              </div>
              <h3><a href={`/blog/${article.id}/`}>{article.title}</a></h3>
              <p class="post-card__excerpt">{article.lead}</p>
              <div class="post-card__meta">
                {article.date && (
                  <span><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>{formatArticleDate(article.date)}</span>
                )}
                <span><span class="material-symbols-outlined" aria-hidden="true">schedule</span>{article.minutes} мин чтения</span>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="b-empty" id="blog-empty" role="status">
        <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
        <p>Ничего не нашлось. Попробуйте изменить запрос или выбрать другую рубрику.</p>
      </div>
    </div>
  </section>

  <section id="channels" class="b-cta">
    <div class="container">
      <h2>Наши каналы</h2>
      <p>Разбираем рынок индустриальной недвижимости, публикуем новые объекты и кейсы раньше, чем они выходят в публикациях.</p>
      <div class="b-cta__row">
        <SiteButton variant="gold" href="https://t.me/mm_prom1" target="_blank">Телеграм-канал</SiteButton>
        <SiteButton variant="outline" href="https://max.ru/channel_MM_PROM" target="_blank">Канал в MAX</SiteButton>
      </div>
    </div>
  </section>

</main>

  <Fragment slot="tail">
    <script is:inline>
    (function(){
      'use strict';
      document.documentElement.classList.add('js');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window && !reduce) {
        var rio = new IntersectionObserver(function(entries){
          entries.forEach(function(en){
            if (!en.isIntersecting) return;
            en.target.classList.add('is-visible');
            rio.unobserve(en.target);
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(function(el){ rio.observe(el); });
      } else {
        reveals.forEach(function(el){ el.classList.add('is-visible'); });
      }
    })();
    </script>

    <script is:inline>
    (function(){
      'use strict';
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.blog-cats__tab'));
      var input = document.getElementById('blog-q');
      var cards = Array.prototype.slice.call(document.querySelectorAll('#feed .post-card'));
      var empty = document.getElementById('blog-empty');
      var form = document.querySelector('.blog-search');
      if (!input || !empty || !cards.length) return;

      var active = 'all';

      function apply(){
        var q = input.value.trim().toLowerCase();
        var shown = 0;
        cards.forEach(function(card){
          var hitCategory = active === 'all' || card.getAttribute('data-category') === active;
          var hitQuery = !q || (card.textContent || '').toLowerCase().indexOf(q) !== -1;
          var hit = hitCategory && hitQuery;
          card.hidden = !hit;
          if (hit) shown++;
        });
        empty.classList.toggle('is-visible', shown === 0);
      }

      tabs.forEach(function(tab){
        tab.addEventListener('click', function(){
          active = tab.getAttribute('data-category') || 'all';
          tabs.forEach(function(item){
            var on = item === tab;
            item.classList.toggle('is-active', on);
            item.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          apply();
        });
      });

      input.addEventListener('input', apply);
      if (form) form.addEventListener('submit', function(event){ event.preventDefault(); });
    })();
    </script>

    <script is:inline src="/assets/site-anim.js?v=5" defer></script>
  </Fragment>
</BaseLayout>
