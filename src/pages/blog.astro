---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteButton from '../components/SiteButton.astro';
import { getCollection } from 'astro:content';

const MONTHS = [
  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
];

// «14 июля 2026» — день без ведущего нуля (спека, §2.4 п. 4).
function formatDate(iso: string): string {
  const [year, month, day] = iso.split('-').map(Number);
  return `${day} ${MONTHS[month - 1]} ${year}`;
}

// Время чтения по объёму тела: max(1, ceil(слов / 200)) (спека, §2.5 п. 10).
function readingMinutes(body: string | undefined): number {
  const plain = (body ?? '').replace(/[#*_>`~\-]/g, ' ');
  const words = plain.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

const articles = (await getCollection('articles'))
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    lead: entry.data.lead,
    date: entry.data.date,
    cover: entry.data.cover,
    minutes: readingMinutes(entry.body),
  }))
  // Порядок: по дате убыв., материал без даты — последним (§2.4 п. 4).
  .sort((a, b) => {
    if (!a.date && !b.date) return a.title.localeCompare(b.title);
    if (!a.date) return 1;
    if (!b.date) return -1;
    return b.date.localeCompare(a.date);
  });
---

<BaseLayout title="Публикации — статьи и кейсы ММ Пром" description="Экспертные статьи и кейсы об индустриальной недвижимости Санкт-Петербурга и Ленобласти: рынок, строительство, продажа, аренда, инвестиции и консалтинг.">
  <Fragment slot="head">
    <style is:inline>
    /* ═══ Страница «Публикации»: шапка раздела и лента статей ═══
       Общие блоки (section, section--tint, grid--3, b-cta, кнопки,
       крошки) — base.css/blocks.css; здесь только карточка публикации. */

    /* ── Шапка раздела: h1 + подводка (по макету docs/mockups/blog.html) ── */
    .b-filters{padding:clamp(28px,4vw,48px) 0 clamp(24px,3vw,40px)}
    .b-filters h1{margin-bottom:12px}
    .b-filters h1::after{content:"";display:block;width:64px;height:4px;border-radius:2px;background:var(--gold);margin-top:10px}
    .b-filters__lead{margin:0;max-width:70ch;color:var(--text-muted)}

    /* ── Карточка публикации (канон .post-card макета) ──────────────────── */
    .post-card{display:flex;flex-direction:column;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:border-color .22s ease,box-shadow .22s ease,transform .22s ease}
    .post-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .post-card__media{position:relative;flex:0 0 auto;aspect-ratio:4/3;background:var(--surface);border-bottom:1px solid var(--border);overflow:hidden}
    .post-card__media img{width:100%;height:100%;object-fit:cover;display:block}
    .post-card__body{display:flex;flex-direction:column;gap:8px;padding:18px;flex:1 1 auto}
    .post-card__body h3{margin:0;font-size:1.0625rem;line-height:1.35}
    .post-card__body h3 a{color:var(--text);text-decoration:none}
    .post-card__body h3 a:hover{color:var(--purple)}
    .post-card__body h3 a:focus-visible{outline:2px solid var(--purple);outline-offset:2px}
    .post-card__excerpt{margin:0;font-size:var(--fs-small);color:var(--text-muted)}
    .post-card__meta{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:auto;padding-top:12px;border-top:1px solid var(--border);font-size:var(--fs-small);color:var(--text-muted)}
    .post-card__meta span{display:inline-flex;align-items:center;gap:6px}
    .post-card__meta .material-symbols-outlined{font-size:16px;color:var(--purple)}

    /* ── Reveal-анимации (как на других страницах) ──────────────────────── */
    html.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .45s ease,transform .45s ease}
    html.js .reveal.is-visible{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){
      html.js .reveal{opacity:1;transform:none;transition:none}
    }
    </style>
  </Fragment>

<main>

  <Breadcrumbs items={[{ href: "/", label: "Главная" }, { label: "Публикации" }]} />

  <section id="filters" class="b-filters">
    <div class="container">
      <h1>Статьи и кейсы</h1>
      <p class="b-filters__lead">Экспертные статьи и кейсы об индустриальной недвижимости Санкт-Петербурга и Ленобласти: рынок, строительство, продажа, аренда, инвестиции и консалтинг.</p>
    </div>
  </section>

  <section id="feed" class="section section--tint">
    <div class="container">
      <div class="grid grid--3">
        {articles.map((article) => (
          <article class="post-card reveal">
            <div class="post-card__media">
              <img src={`${article.cover}?v=1`} alt={`Обложка: ${article.title}`} loading="lazy" decoding="async">
            </div>
            <div class="post-card__body">
              <h3><a href={`/blog/${article.id}/`}>{article.title}</a></h3>
              <p class="post-card__excerpt">{article.lead}</p>
              <div class="post-card__meta">
                {article.date && (
                  <span><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>{formatDate(article.date)}</span>
                )}
                <span><span class="material-symbols-outlined" aria-hidden="true">schedule</span>{article.minutes} мин чтения</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="channels" class="b-cta">
    <div class="container">
      <h2>Наши каналы</h2>
      <p>Разбираем рынок индустриальной недвижимости, публикуем новые объекты и кейсы раньше, чем они выходят в публикациях.</p>
      <div class="b-cta__row">
        <SiteButton variant="gold" href="https://t.me/mm_prom1" target="_blank">Телеграм-канал</SiteButton>
        <SiteButton variant="outline" href="https://max.ru/channel_MM_PROM" target="_blank">Канал в MAX</SiteButton>
      </div>
    </div>
  </section>

</main>

  <Fragment slot="tail">
    <script is:inline>
    (function(){
      'use strict';
      document.documentElement.classList.add('js');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window && !reduce) {
        var rio = new IntersectionObserver(function(entries){
          entries.forEach(function(en){
            if (!en.isIntersecting) return;
            en.target.classList.add('is-visible');
            rio.unobserve(en.target);
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(function(el){ rio.observe(el); });
      } else {
        reveals.forEach(function(el){ el.classList.add('is-visible'); });
      }
    })();
    </script>

    <script is:inline src="/assets/site-anim.js?v=1" defer></script>
  </Fragment>
</BaseLayout>
