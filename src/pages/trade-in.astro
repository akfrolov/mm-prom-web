---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Трейд-ин / Срочный выкуп — ММ Пром" description="Трейд-ин и срочный выкуп от ММ Пром: принимаем ваш актив — здание, земельный участок или оборудование — и зачитываем его стоимость при приобретении нового объекта. Справедливая зачётная стоимость, синхронизация сделки, расчёт сразу после сделки.">
  <Fragment slot="head">
    <style is:inline>
    /* ═══════════════════════════════════════════════════════════════════════
       ММ ПРОМ — ГЛАВНАЯ СТРАНИЦА
       Дизайн по брендбуку «МИ ПРОМ ГРУППА КОМПАНИЙ» (2026):
       • тёмно-синий (доверие, профессионализм) — доминанта,
       • глубокий фиолетовый (премиальность) — акценты,
       • золотисто-жёлтый (успех) — маркеры, CTA, логотип,
       • белый (чистота, пространство),
       • фирменный мотив — геометрические квадраты (структура, порядок).
       Стиль: деловой, современный, технологичный, премиальный.
       ═══════════════════════════════════════════════════════════════════════ */
    :root{
      --navy:#0E0028;          /* тёмно-фиолетовый — текст/доминанта */
      --navy-2:#1A0F3D;
      --navy-3:#2A1B5E;
      --purple:#5A3994;        /* фиолетовый — основной акцент */
      --purple-dark:#4A2E7A;
      --purple-soft:#F0ECF8;   /* светло-фиолетовая подложка */
      --gold:#EBB81E;          /* золотисто-жёлтый — акцент */
      --gold-soft:#F6E7B6;
      --gold-deep:#C9960F;
      --white:#FFFFFF;
      --text:#0E0028;
      --text-muted:#5C5C66;
      --surface:#F7F7F8;
      --border:#E6E3EE;
      --font:"Inter","Manrope","Averta CY",-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
      --fs-h1:clamp(1.9rem,1.2rem + 3vw,3.4rem);
      --fs-h2:clamp(1.45rem,1.1rem + 1.7vw,2.25rem);
      --fs-h3:clamp(1.15rem,1rem + 0.8vw,1.5rem);
      --fs-body:clamp(1rem,0.95rem + 0.25vw,1.0625rem);
      --fs-small:0.875rem;
      --radius:14px;
      --radius-sm:10px;
      --shadow:0 10px 34px rgba(11,27,51,.10);
      --container:1280px;
      --space-section:clamp(56px,9vw,110px);
      --header-h:73px;
      --marquee-h:49px;
    }
    *,*::before,*::after{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
    body{margin:0;font-family:var(--font);color:var(--text);background:var(--white);line-height:1.6;font-size:var(--fs-body)}
    img{max-width:100%;display:block}
    a{color:var(--purple)}
    h1,h2,h3{line-height:1.18;margin:0 0 .5em;font-weight:800;letter-spacing:-.01em}
    h1{font-size:var(--fs-h1)}
    h2{font-size:var(--fs-h2)}
    h3{font-size:var(--fs-h3)}
    p{margin:0 0 1em}
    .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 500,'GRAD' 0,'opsz' 24;vertical-align:middle}
    .container{max-width:var(--container);margin:0 auto;padding:0 32px}
    @media (min-width:768px){.container{padding:0 32px}}
    @media (min-width:1024px){.container{padding:0 40px}}
    .section{padding:var(--space-section) 0}
    .section--tint{background:var(--surface)}

    /* ── Фирменный мотив: геометрические квадраты ───────────────────────── */
    .sq-grid{position:relative;overflow:hidden}
    .sq-grid::before{content:"";position:absolute;inset:0;pointer-events:none;
      background-image:
        linear-gradient(rgba(61,14,106,.05) 1px,transparent 1px),
        linear-gradient(90deg,rgba(61,14,106,.05) 1px,transparent 1px);
      background-size:56px 56px}
    .sq-grid::after{content:"";position:absolute;width:120px;height:120px;right:-40px;top:-40px;border:2px solid rgba(235,184,30,.35);transform:rotate(12deg)}
    .sq-float{position:absolute;border:2px solid rgba(235,184,30,.4);pointer-events:none}
    .sq-float--1{width:64px;height:64px;left:6%;bottom:12%;transform:rotate(18deg)}
    .sq-float--2{width:34px;height:34px;right:8%;top:18%;background:rgba(61,14,106,.35);transform:rotate(45deg)}
    .sq-float--3{width:22px;height:22px;left:48%;top:10%;border-color:rgba(61,14,106,.25)}

    /* ── Брендбук: рассыпанные цветные квадраты (пиксельный паттерн) ─────── */
    .brand-squares{position:absolute;pointer-events:none;z-index:1}
    .brand-squares span{position:absolute;display:block;border-radius:2px}

    /* ── Кнопки ──────────────────────────────────────────────────────────── */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:13px 26px;border-radius:var(--radius-sm);font-weight:700;font-size:var(--fs-body);text-decoration:none;cursor:pointer;border:2px solid transparent;transition:transform .18s ease,box-shadow .18s ease,background .18s ease,color .18s ease}
    .btn:hover{transform:translateY(-2px)}
    .btn--gold{background:var(--gold);color:var(--navy);box-shadow:0 8px 22px rgba(235,184,30,.35)}
    .btn--gold:hover{background:var(--gold-soft)}
    .btn--purple{background:var(--purple);color:#fff}
    .btn--purple:hover{background:var(--purple-dark)}
    .btn--ghost-light{border-color:rgba(255,255,255,.5);color:#fff;background:transparent}
    .btn--ghost-light:hover{background:#fff;color:var(--navy)}
    .btn--outline{border-color:var(--purple);color:var(--purple);background:#fff;box-shadow:0 8px 22px rgba(90,57,148,.16)}
    .btn--outline:hover{background:var(--purple);color:#fff}

    /* ── Шапка ───────────────────────────────────────────────────────────── */
    .site-header{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
    .site-header__inner{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:72px}
    .site-header__logo{display:inline-flex;align-items:center;gap:12px;text-decoration:none;margin-left:-24px}
    @media (min-width:768px){.site-header__logo{margin-left:-36px}}
    @media (min-width:1024px){.site-header__logo{margin-left:-44px}}
    .site-header__logo img{height:60px;width:auto;display:block}
    .logo-emblem{display:block;flex:0 0 auto}
    .logo-text{display:flex;flex-direction:column;line-height:1.1}
    .logo-text b{font-size:1.15rem;font-weight:800;color:var(--navy);letter-spacing:.04em}
    .logo-text span{font-size:.62rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--text-muted)}
    .site-header__nav{display:none;align-items:center;gap:2px}
    .site-header__nav a{display:inline-flex;align-items:center;min-height:44px;padding:8px 14px;color:var(--text);text-decoration:none;font-weight:600;white-space:nowrap;border-radius:8px}
    .site-header__nav a:hover{color:var(--purple);background:var(--purple-soft)}

    /* ── Мегаменю «Услуги» (роль → услуга) ──────────────────────────────── */
    .nav-item--has-mega{position:relative}
    .nav-item--has-mega > a{display:inline-flex;align-items:center;gap:4px}
    .mega{position:absolute;top:100%;left:0;width:min(1040px,94vw);display:none;background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 20px 50px rgba(11,27,51,.15);z-index:50;overflow:hidden}
    .nav-item--has-mega:hover .mega{display:flex}
    .mega__roles{flex:0 0 280px;background:linear-gradient(135deg,var(--purple) 0%,var(--navy) 100%);color:#fff;padding:32px 24px}
    .mega__title{margin:0 0 20px;font-size:var(--fs-small);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6)}
    .mega__role{display:flex;align-items:flex-start;gap:12px;width:100%;min-height:48px;padding:12px 14px;margin-bottom:6px;border:0;background:none;color:#fff;font:inherit;text-align:left;cursor:pointer;border-radius:10px;transition:background .2s ease}
    .mega__role:hover,.mega__role.is-active{background:rgba(255,255,255,.14)}
    .mega__role-icon{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;background:rgba(235,184,30,.15);color:var(--gold);flex:0 0 auto}
    .mega__role-icon .material-symbols-outlined{font-size:20px}
    .mega__role-text{display:flex;flex-direction:column;gap:2px;flex:1}
    .mega__role-text strong{color:#fff;font-weight:700;font-size:.95rem}
    .mega__role-text span{color:rgba(255,255,255,.6);font-size:.78rem;line-height:1.3}
    .mega__role-more{display:inline-flex;align-items:center;gap:4px;color:var(--gold);font-size:.75rem;font-weight:600;margin-top:6px}
    .mega__role-more .material-symbols-outlined{font-size:16px}
    .mega__services{flex:1;padding:32px 28px}
    .mega__services-panel{display:none}
    .mega__services-panel.is-active{display:grid;grid-template-columns:repeat(2,1fr);gap:6px 32px;align-content:start}
    .mega__services-panel h4{grid-column:1/-1;margin:0 0 12px;font-size:var(--fs-small);font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted)}
    .mega__services-panel a{display:flex;align-items:center;gap:12px;min-height:44px;padding:6px 8px;color:var(--text);text-decoration:none;font-weight:600;font-size:var(--fs-small);border-radius:8px;transition:background .2s ease,color .2s ease}
    .mega__services-panel a:hover{color:var(--purple);background:var(--purple-soft)}
    .mega__services-panel a .material-symbols-outlined{font-size:20px;color:var(--purple)}
    .mega__all{margin-top:18px;justify-self:start}
    .mega__catalog{margin-top:12px;justify-self:start}
    .mega__phone{margin-top:14px;justify-self:start}
    .mega__foot{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 28px;border-top:1px solid var(--border);background:var(--surface)}
    .mega__foot .btn{min-height:40px;padding:8px 18px;font-size:var(--fs-small)}
    .site-header__actions{display:flex;align-items:center;gap:10px}
    .site-header__phone{display:none;font-weight:800;font-size:.95rem;color:var(--navy);text-decoration:none;white-space:nowrap}
    .site-header__phone:hover{color:var(--purple)}
    .site-header__cta{display:none;white-space:nowrap;flex:0 0 auto}
    .site-header__burger{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;background:none;color:var(--navy);cursor:pointer}
    .site-header__burger .material-symbols-outlined{font-size:28px}

    /* ── Мобильное меню ─────────────────────────────────────────────────── */
    .mobile-menu{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border-bottom:1px solid var(--border);box-shadow:0 20px 40px rgba(11,27,51,.12);padding:16px 20px 24px;z-index:45}
    .mobile-menu.is-open{display:block}
    .mobile-menu__nav{display:flex;flex-direction:column}
    .mobile-menu__nav a{display:flex;align-items:center;min-height:48px;padding:10px 0;color:var(--text);text-decoration:none;font-weight:600;border-bottom:1px solid var(--border)}
    .mobile-menu__nav a:hover{color:var(--purple)}
    .mobile-menu__actions{display:flex;flex-direction:column;gap:12px;margin-top:16px}
    .mobile-menu__actions .btn{width:100%}
    @media (min-width:1024px){.mobile-menu{display:none!important}}

    /* Мобильное меню: аккордеон «Услуги» по ролям */
    .mobile-menu__item{border-bottom:1px solid var(--border)}
    .mobile-menu__toggle{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;padding:10px 0;border:0;background:none;color:var(--text);font:inherit;font-weight:600;cursor:pointer}
    .mobile-menu__toggle .material-symbols-outlined{transition:transform .2s ease}
    .mobile-menu__toggle.is-open .material-symbols-outlined{transform:rotate(180deg)}
    .mobile-menu__sub{display:none;padding-left:12px}
    .mobile-menu__sub.is-open{display:block}
    .mobile-menu__role{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:44px;padding:8px 0;border:0;background:none;color:var(--text);font:inherit;font-weight:600;cursor:pointer}
    .mobile-menu__role .material-symbols-outlined{transition:transform .2s ease}
    .mobile-menu__role.is-open .material-symbols-outlined{transform:rotate(180deg)}
    .mobile-menu__services{display:none;padding-left:12px}
    .mobile-menu__services.is-open{display:block}
    .mobile-menu__services a{display:block;min-height:40px;padding:8px 0;color:var(--text-muted);text-decoration:none;font-size:var(--fs-small);font-weight:500}
    .mobile-menu__services a:hover{color:var(--purple)}
    @media (min-width:768px){.site-header__cta{display:inline-flex}}
    @media (min-width:1200px){.site-header__phone{display:inline-flex}}
    @media (min-width:1024px){
      .site-header__nav{display:flex}
      .site-header__burger{display:none}
    }

    /* ── Герой (светлый, геометрический паттерн) ─────────────────────────── */
    .b-hero{background:linear-gradient(180deg,#fff 0%,var(--surface) 100%);color:var(--text);position:relative;overflow:hidden}
    .b-hero__glow{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(120px);opacity:.5;pointer-events:none}
    .b-hero__glow--purple{background:var(--purple-soft);top:-160px;right:-80px}
    .b-hero__glow--gold{background:rgba(235,184,30,.28);bottom:-200px;left:-100px}
    .b-hero__glow--purple{animation:b-glow-pulse 9s ease-in-out infinite}
    .b-hero__glow--gold{animation:b-glow-pulse 12s ease-in-out infinite reverse}
    @keyframes b-glow-pulse{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.18);opacity:.75}}
    .b-hero__particles{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}
    .b-hero__particles span{position:absolute;bottom:-24px;border-radius:2px;opacity:0;animation:b-rise linear infinite}
    .b-hero__particles span:nth-child(1){left:8%;width:10px;height:10px;background:rgba(90,57,148,.35);animation-duration:14s;animation-delay:0s}
    .b-hero__particles span:nth-child(2){left:22%;width:6px;height:6px;background:rgba(235,184,30,.4);animation-duration:18s;animation-delay:2s}
    .b-hero__particles span:nth-child(3){left:38%;width:12px;height:12px;background:rgba(185,166,216,.4);animation-duration:16s;animation-delay:4s}
    .b-hero__particles span:nth-child(4){left:55%;width:7px;height:7px;background:rgba(168,198,134,.4);animation-duration:20s;animation-delay:1s}
    .b-hero__particles span:nth-child(5){left:72%;width:9px;height:9px;background:rgba(217,192,138,.4);animation-duration:15s;animation-delay:3s}
    .b-hero__particles span:nth-child(6){left:88%;width:5px;height:5px;background:rgba(90,57,148,.3);animation-duration:22s;animation-delay:5s}
    @keyframes b-rise{0%{transform:translateY(0) rotate(0);opacity:0}10%{opacity:.7}90%{opacity:.5}100%{transform:translateY(-110vh) rotate(180deg);opacity:0}}
    @media (prefers-reduced-motion:reduce){
      .b-hero__glow--purple,.b-hero__glow--gold,.b-hero__particles span{animation:none}
      .b-hero__particles span{opacity:0}
    }
    .b-hero__inner{position:relative;z-index:2;display:grid;gap:40px;padding:clamp(40px,6vw,72px) 0}
    .b-hero__eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 20px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--purple)}
    .b-hero__eyebrow::before{content:"";width:34px;height:3px;border-radius:2px;background:var(--gold)}
    .b-hero h1{color:var(--navy);margin-bottom:.35em}
    .b-hero h1 .accent{color:var(--purple)}
    .b-hero__lead{color:var(--text-muted);max-width:56ch;font-size:1.08em}
    .b-hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin:20px 0 28px}
    .b-hero__metrics{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:22px 18px}
    .b-hero__metrics li{border-top:3px solid var(--gold);padding-top:14px}
    .b-hero__metrics strong{display:block;font-size:clamp(1.1rem,1rem + .6vw,1.5rem);color:var(--purple);font-weight:800;white-space:nowrap}
    .b-hero__metrics span{display:block;color:var(--text-muted);font-size:var(--fs-small)}
    .b-hero__media{min-width:0;position:relative}
    .b-hero__media-frame{padding:3px;background:linear-gradient(135deg,var(--gold) 0%,var(--purple) 100%);position:relative;overflow:hidden;border-radius:0}
    .b-hero__media-frame .img-placeholder{width:100%;aspect-ratio:16/9;border:0;border-radius:0;background:var(--surface);color:var(--text-muted)}
    .b-hero__video{position:absolute;top:3px;left:3px;width:calc(100% - 6px);height:calc(100% - 6px);object-fit:cover;display:block}
    .b-hero__sound{position:absolute;right:16px;bottom:16px;z-index:2;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 16px;border-radius:999px;border:1px solid var(--border);background:rgba(255,255,255,.9);color:var(--navy);font:inherit;font-size:var(--fs-small);font-weight:600;cursor:pointer;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);box-shadow:0 4px 14px rgba(11,27,51,.1)}
    .b-hero__sound:hover{background:#fff}
    @media (min-width:768px){
      .b-hero{min-height:calc(100vh - var(--header-h) - var(--marquee-h));display:flex;align-items:center}
      @supports (min-height:100svh){.b-hero{min-height:calc(100svh - var(--header-h) - var(--marquee-h))}}
      .b-hero__inner{flex:1 1 auto;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
      .b-hero__metrics{grid-template-columns:repeat(2,1fr)}
      .b-hero__media{max-width:calc(100vh - var(--header-h) - var(--marquee-h) - 48px)}
    }
    @media (min-width:1024px){
      .b-hero__inner{gap:56px}
      .b-hero__metrics{grid-template-columns:repeat(4,1fr)}
      .b-hero__media-frame .img-placeholder{aspect-ratio:16/9}
    }

    /* ── Marquee (золотая полоса) ────────────────────────────────────────── */
    .b-marquee{background:var(--gold);border-bottom:1px solid var(--gold-deep);padding:14px 0;overflow:hidden}
    .b-marquee__track{display:flex;width:max-content;animation:b-marquee-roll 30s linear infinite}
    .b-marquee__seq{display:flex;align-items:center;flex:0 0 auto}
    .b-marquee__item{display:inline-flex;align-items:center;white-space:nowrap;font-weight:800;font-size:var(--fs-small);letter-spacing:.04em;text-transform:uppercase;color:var(--navy)}
    .b-marquee__item::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--purple);margin:0 24px}
    @keyframes b-marquee-roll{to{transform:translateX(-50%)}}
    @media (prefers-reduced-motion:reduce){
      .b-marquee__track{animation:none;width:auto;flex-wrap:wrap;row-gap:4px}
      .b-marquee__seq--dup{display:none}
    }

    /* ── Заголовки секций ────────────────────────────────────────────────── */
    .sec-index{display:inline-flex;align-items:center;gap:10px;margin:0 0 16px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted)}
    .sec-index::before{content:"";width:30px;height:3px;border-radius:2px;background:var(--gold)}
    .sec-index--light{color:rgba(255,255,255,.6)}
    .b-rowhead{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;margin-bottom:36px}
    .b-rowhead h2{margin:0}
    .b-rowhead > p{margin:0;flex-basis:100%;color:var(--text-muted)}
    .b-more{display:inline-flex;align-items:center;gap:6px;font-weight:700;text-decoration:none;color:var(--purple)}
    .b-more .material-symbols-outlined{font-size:20px;transition:transform .2s ease}
    .b-more:hover .material-symbols-outlined{transform:translateX(4px)}

    /* ── Комплексное сопровождение (шаги 01–06) ──────────────────────────── */
    .b-steps{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:1fr}
    .b-steps__item{display:flex;background:#fff;border:1px solid var(--border);border-radius:var(--radius);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-steps__item:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-steps__link{display:flex;flex:1 1 auto;gap:18px;align-items:flex-start;height:100%;padding:26px 22px;color:inherit;text-decoration:none}
    .b-steps__num{flex:0 0 auto;min-width:2.2ch;font-size:clamp(2.6rem,1.9rem + 2.8vw,3.8rem);line-height:1;font-weight:800;color:transparent;-webkit-text-stroke:1.5px var(--purple-soft);transition:color .2s ease,-webkit-text-stroke-color .2s ease}
    .b-steps__item:hover .b-steps__num{color:var(--gold);-webkit-text-stroke-color:transparent}
    .b-steps__icon{display:block;margin-bottom:8px;color:var(--purple);font-size:28px}
    .b-steps__body h3{margin:0 0 4px;font-size:1.1rem}
    .b-steps__body p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    @media (min-width:768px){.b-steps{grid-template-columns:repeat(2,1fr);gap:24px}}
    @media (min-width:1024px){.b-steps{grid-template-columns:repeat(3,1fr)}}

    /* ── Конвейер полного цикла (второй блок) ────────────────────────────── */
    .b-conveyor{position:relative}
    .b-conveyor__line{position:absolute;top:22px;left:0;right:0;height:2px;background:repeating-linear-gradient(90deg,var(--purple) 0 10px,transparent 10px 20px);opacity:.35;pointer-events:none;display:none}
    .b-conveyor__runner{position:absolute;top:18px;left:0;width:10px;height:10px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 4px rgba(235,184,30,.25);pointer-events:none;display:none}
    @keyframes b-conveyor-run{0%{left:0}100%{left:calc(100% - 10px)}}
    .b-conveyor__note{display:inline-flex;align-items:center;gap:10px;margin:28px 0 0;padding:14px 20px;border-radius:var(--radius-sm);background:var(--purple-soft);color:var(--purple);font-weight:700;font-size:var(--fs-small)}
    .b-conveyor__note .material-symbols-outlined{font-size:20px}
    /* Компактный второй блок (на один экран) */
    .b-advantages--compact{padding:clamp(32px,5vw,56px) 0}
    .b-advantages--compact h2{margin-bottom:.3em}
    .b-advantages--compact .b-advantages__lead{margin-bottom:24px}
    .b-advantages--compact .b-conveyor__note{margin-top:20px}
    /* Этап «пройден» при прохождении бегунка */
    .b-steps--conveyor .b-steps__item.is-passed .b-steps__num{color:var(--gold);-webkit-text-stroke-color:transparent}
    .b-steps--conveyor .b-steps__item.is-passed .b-steps__icon{color:var(--gold)}
    .b-steps--conveyor .b-steps__item.is-passed .b-steps__body h3{color:var(--purple)}
    @media (min-width:1024px){
      .b-conveyor__line,.b-conveyor__runner{display:block}
      .b-steps--conveyor{grid-template-columns:repeat(6,1fr);gap:14px}
      .b-steps--conveyor .b-steps__item{background:transparent;border:0;box-shadow:none}
      .b-steps--conveyor .b-steps__item:hover{transform:none;box-shadow:none}
      .b-steps--conveyor .b-steps__link{flex-direction:column;align-items:flex-start;padding:0;gap:0;height:auto}
      .b-steps--conveyor .b-steps__num{font-size:2.2rem;height:44px;display:flex;align-items:center;margin-bottom:14px}
      .b-steps--conveyor .b-steps__icon{margin-bottom:10px}
      .b-steps--conveyor .b-steps__body h3{font-size:1rem}
    }
    @media (max-width:767.98px){
      .b-steps--conveyor{position:relative;padding-left:30px}
      .b-steps--conveyor::before{content:"";position:absolute;left:6px;top:10px;bottom:10px;width:2px;background:repeating-linear-gradient(180deg,var(--purple) 0 8px,transparent 8px 16px);opacity:.35}
      .b-steps--conveyor .b-steps__item{position:relative}
      .b-steps--conveyor .b-steps__item::before{content:"";position:absolute;left:-30px;top:34px;width:14px;height:14px;border-radius:50%;background:var(--gold);border:2px solid var(--purple)}
    }

    /* ── Иконки-плашки ───────────────────────────────────────────────────── */
    .b-advantages__icon{display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:12px;background:var(--purple-soft);color:var(--purple);margin-bottom:14px}
    .b-advantages__icon .material-symbols-outlined{font-size:26px}

    /* ── Клиенты ─────────────────────────────────────────────────────────── */
    .b-clients__card{display:flex;flex-direction:column;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:26px;color:var(--text);text-decoration:none;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-clients__card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-clients__card h3{margin:0 0 6px;font-size:1.15rem}
    .b-clients__card > p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    .b-clients__go{display:inline-flex;align-items:center;gap:6px;margin-top:auto;padding-top:18px;font-weight:700;color:var(--purple)}
    .b-clients__go .material-symbols-outlined{font-size:20px;transition:transform .2s ease}
    .b-clients__card:hover .b-clients__go .material-symbols-outlined{transform:translateX(4px)}

    /* ── Комплексные решения (перечисление услуг) ────────────────────────── */
    .b-services__card{height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-services__card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-services__card h3{margin:0 0 6px;font-size:1.15rem}
    .b-services__card p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}

    /* ── Карта ролей (третий блок, один экран) ───────────────────────────── */
    .b-roles{display:grid;gap:32px;align-items:center}
    .b-roles__intro h2{margin-bottom:.4em}
    .b-roles__intro > p{color:var(--text-muted);margin:0 0 22px}
    .b-roles__hint{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:999px;background:var(--purple-soft);color:var(--purple);font-weight:700;font-size:var(--fs-small);animation:b-hint-pulse 2.2s ease-in-out infinite}
    .b-roles__hint .material-symbols-outlined{font-size:18px}
    @keyframes b-hint-pulse{
      0%,100%{box-shadow:0 0 0 0 rgba(90,57,148,.35);transform:scale(1)}
      50%{box-shadow:0 0 0 12px rgba(90,57,148,0);transform:scale(1.05)}
    }
    @media (prefers-reduced-motion:reduce){.b-roles__hint{animation:none}}
    .b-roles__grid{display:grid;gap:16px;grid-template-columns:1fr}
    .b-roles__grid .b-clients__card{padding:22px}
    .b-roles__grid .b-clients__card h3{font-size:1.1rem}
    @media (min-width:768px){
      .b-roles__grid{grid-template-columns:repeat(2,1fr);gap:20px}
    }
    @media (min-width:1024px){
      .b-roles{grid-template-columns:0.85fr 1.15fr;gap:56px}
    }

    /* ── Сетка ───────────────────────────────────────────────────────────── */
    .grid{display:grid;gap:16px}
    .grid--2,.grid--3,.grid--4{grid-template-columns:1fr}
    @media (min-width:768px){.grid{gap:24px}.grid--2,.grid--3,.grid--4{grid-template-columns:repeat(2,1fr)}}
    @media (min-width:1024px){.grid--3{grid-template-columns:repeat(3,1fr)}.grid--4{grid-template-columns:repeat(4,1fr)}}

    /* ── Объекты (горизонтальная лента) ──────────────────────────────────── */
    .b-rail-group{margin-top:40px}
    .b-rail-group > h3{margin:0 0 18px;font-size:var(--fs-h3);display:flex;align-items:center;gap:10px}
    .b-rail-group > h3::before{content:"";width:12px;height:12px;background:var(--gold);transform:rotate(45deg);flex:0 0 auto}
    .b-rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:14px;scrollbar-width:thin}
    .b-rail::-webkit-scrollbar{height:6px}
    .b-rail::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
    .b-rail > *{flex:0 0 84vw;max-width:360px;scroll-snap-align:start}
    @media (min-width:768px){.b-rail{gap:20px}.b-rail > *{flex:0 0 340px}}

    .obj-card{position:relative;display:flex;flex-direction:column;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:box-shadow .2s ease,transform .2s ease}
    .obj-card:hover{box-shadow:var(--shadow);transform:translateY(-3px)}
    .obj-card .img-placeholder{border:0;border-bottom:1px solid var(--border);border-radius:0;min-height:150px;flex:1 1 auto}
    .obj-card__body{display:flex;flex-direction:column;gap:8px;padding:18px;flex:1 1 auto}
    .obj-card__badges{display:flex;align-items:center;flex-wrap:wrap;justify-content:space-between;gap:8px;min-height:24px}
    .obj-card__link{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;margin:-10px -6px -10px auto;color:var(--purple)}
    .obj-card__link .material-symbols-outlined{font-size:20px}
    .obj-card__link::after{content:"";position:absolute;inset:0}
    .obj-card__body h3{margin:0;font-size:1.1rem;line-height:1.3}
    .obj-card__desc{margin:0;font-size:var(--fs-small);color:var(--text-muted)}
    .obj-card__meta{display:grid;gap:4px;list-style:none;margin:0;padding:0;font-size:var(--fs-small);color:var(--text-muted)}
    .obj-card__meta li{display:flex;align-items:center;gap:8px}
    .obj-card__meta .material-symbols-outlined{font-size:18px;color:var(--purple)}
    .obj-card__meta .icon-loc{flex:0 0 auto}
    .obj-card__meta strong{color:var(--text);font-weight:600}
    .obj-card__presentation{position:absolute;top:12px;left:12px;z-index:2;display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:6px 12px;border:1px solid var(--border);border-radius:999px;background:#fff;color:var(--text);font-size:var(--fs-small);font-weight:600;text-decoration:none;box-shadow:0 4px 14px rgba(11,27,51,.12)}
    .obj-card__presentation .material-symbols-outlined{font-size:18px}
    .obj-card__presentation:hover{border-color:var(--purple);color:var(--purple)}
    .b-media{margin:0;display:flex;flex-direction:column;background:var(--surface)}
    .b-media img{display:block;width:100%;flex:1 1 auto;object-fit:cover}
    .b-media img.is-broken{display:none}
    .b-media figcaption{padding:8px 12px;font-size:var(--fs-small);color:var(--text-muted);border-top:1px solid var(--border)}
    .obj-card .b-media img{aspect-ratio:16/10}


    /* ── Бейджи ──────────────────────────────────────────────────────────── */
    .badge{display:inline-flex;align-items:center;gap:6px;min-height:26px;padding:3px 12px;border-radius:999px;font-size:var(--fs-small);font-weight:700}
    .badge--park,.badge--technopark{background:rgba(235,184,30,.2);color:var(--navy)}

    /* ── Заглушка изображения ────────────────────────────────────────────── */
    .img-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius);color:var(--text-muted);font-size:var(--fs-small);min-height:180px;padding:16px;text-align:center}
    .img-placeholder .material-symbols-outlined{font-size:36px;color:var(--border)}

    /* ── Стандарты строительства ─────────────────────────────────────────── */
    .b-split{display:grid;gap:24px;align-items:stretch;margin-bottom:36px}
    .b-split__media{height:100%;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
    .b-split__media img{width:100%;height:100%;object-fit:cover;aspect-ratio:4/3}
    .b-split__list{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:1fr;grid-auto-rows:1fr;height:100%}
    .b-split__item{display:flex;flex-direction:column;gap:12px;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px}
    .b-split__item .b-advantages__icon{flex:0 0 auto;margin:0}
    .b-split__item h3{margin:0 0 4px;font-size:1.15rem}
    .b-split__item p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    @media (min-width:768px){.b-split{gap:32px}.b-split__list{grid-template-columns:repeat(2,1fr)}}
    @media (min-width:1024px){.b-split{grid-template-columns:1fr 1fr}}

    /* ── Стандарты: изображение слева + диаграмма контроля справа ────────── */
    .b-standards{display:grid;gap:24px}
    .b-standards__media{border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
    .b-standards__media img{width:100%;object-fit:cover;aspect-ratio:4/3}
    @media (min-width:768px) and (max-width:1023.98px){.b-standards__media img{aspect-ratio:16/9}}

    /* ── Диаграмма контроля (блок «Стандарты строительства») ─────────────── */
    .b-control{display:grid;grid-template-columns:1fr;gap:16px;margin-top:8px}
    .b-control__lines,.b-control__center{display:none}
    .b-control__node{position:static;width:auto;transform:none;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease}
    .b-control__node:hover{border-color:var(--purple);box-shadow:var(--shadow)}
    .b-control__node h3{margin:0 0 4px;font-size:1.1rem}
    .b-control__node p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    .b-control__icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:12px;background:var(--purple-soft);color:var(--purple);margin-bottom:12px}
    .b-control__icon .material-symbols-outlined{font-size:24px}
    @media (min-width:768px) and (max-width:1023.98px){.b-control{grid-template-columns:repeat(2,1fr)}}
    @media (min-width:1024px){
      .b-standards{grid-template-columns:1fr 1fr;gap:48px;align-items:center}
      .b-standards__media{height:100%}
      .b-standards__media img{height:100%;aspect-ratio:4/3}
      .b-control{position:relative;display:block;height:460px;max-width:520px;margin:0 auto}
      .b-control__lines,.b-control__center{display:flex}
      .b-control__lines{position:absolute;inset:0;width:100%;height:100%}
      .b-control__center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:160px;height:160px;border-radius:50%;background:linear-gradient(135deg,var(--purple) 0%,var(--navy) 100%);color:#fff;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:3px;box-shadow:0 20px 50px rgba(90,57,148,.35);z-index:2;padding:16px}
      .b-control__center .material-symbols-outlined{font-size:30px;color:var(--gold)}
      .b-control__center strong{font-size:.95rem;font-weight:800}
      .b-control__center span{font-size:var(--fs-small);color:rgba(255,255,255,.75)}
      .b-control__node{position:absolute;width:200px;z-index:2}
      .b-control__node--1{top:0;left:50%;transform:translateX(-50%)}
      .b-control__node--2{top:50%;right:0;transform:translateY(-50%)}
      .b-control__node--3{bottom:0;left:50%;transform:translateX(-50%)}
      .b-control__node--4{top:50%;left:0;transform:translateY(-50%)}
    }

    /* ── Вертикальная диаграмма контроля (надёжная) ──────────────────────── */
    .b-flow{position:relative;padding-left:44px}
    .b-flow::before{content:"";position:absolute;left:17px;top:8px;bottom:8px;width:2px;background:repeating-linear-gradient(180deg,var(--purple) 0 8px,transparent 8px 16px);opacity:.35}
    .b-flow__step{position:relative;margin-bottom:20px}
    .b-flow__step:last-child{margin-bottom:0}
    .b-flow__dot{position:absolute;left:-44px;top:0;width:36px;height:36px;border-radius:50%;background:var(--purple);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.9rem;border:3px solid var(--gold);box-shadow:0 4px 12px rgba(90,57,148,.3)}
    .b-flow__body{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px 20px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease}
    .b-flow__body:hover{border-color:var(--purple);box-shadow:var(--shadow)}
    .b-flow__body h3{margin:0 0 4px;font-size:1.05rem}
    .b-flow__body p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}

    /* ── Стандарты строительства: горизонтальный слайдер-бегунок ─────────── */
    .b-std-slider{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:14px;scrollbar-width:thin}
    .b-std-slider::-webkit-scrollbar{height:6px}
    .b-std-slider::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
    .b-std-card{flex:0 0 300px;scroll-snap-align:start;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-std-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-std-card__num{display:block;font-size:2rem;font-weight:800;color:transparent;-webkit-text-stroke:1.5px var(--purple-soft);margin-bottom:12px}
    .b-std-card__icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:12px;background:var(--purple-soft);color:var(--purple);margin-bottom:14px}
    .b-std-card__icon .material-symbols-outlined{font-size:24px}
    .b-std-card h3{margin:0 0 6px;font-size:1.1rem}
    .b-std-card p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}

    /* ── Стандарты строительства: сетка 2×2 с галочками ──────────────────── */
    .b-std-grid{display:grid;gap:20px;grid-template-columns:1fr}
    @media (min-width:768px){.b-std-grid{grid-template-columns:repeat(2,1fr)}}
    .b-std-grid__card{position:relative;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-std-grid__card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-std-grid__check{position:absolute;top:20px;right:20px;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:var(--gold);color:#fff}
    .b-std-grid__check .material-symbols-outlined{font-size:18px}
    .b-std-grid__icon{display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:12px;background:var(--purple-soft);color:var(--purple);margin-bottom:16px}
    .b-std-grid__icon .material-symbols-outlined{font-size:26px}
    .b-std-grid__card h3{margin:0 0 6px;font-size:1.15rem}
    .b-std-grid__card p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}

    /* ── Вертикальный список стандартов с прогресс-барами ─────────────────── */
    .b-progress{display:grid;gap:16px;max-width:780px;margin:0 auto}
    .b-progress__item{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease}
    .b-progress__item:hover{border-color:var(--purple);box-shadow:var(--shadow)}
    .b-progress__head{display:flex;align-items:flex-start;gap:16px}
    .b-progress__icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:12px;background:var(--purple-soft);color:var(--purple);flex:0 0 auto}
    .b-progress__icon .material-symbols-outlined{font-size:24px}
    .b-progress__text{flex:1}
    .b-progress__text h3{margin:0 0 4px;font-size:1.1rem}
    .b-progress__text p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    .b-progress__value{font-weight:800;color:var(--purple);font-size:1.1rem;white-space:nowrap}
    .b-progress__bar{height:8px;border-radius:999px;background:var(--surface);margin-top:16px;overflow:hidden}
    .b-progress__bar span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--purple) 0%,var(--gold) 100%)}

    /* ── Баннер ТЗ ───────────────────────────────────────────────────────── */
    .b-tz-banner{grid-template-columns:minmax(0,1fr);align-items:center;gap:16px}
    .b-tz-banner__cta{justify-self:end}
    @media (min-width:1024px){.b-tz-banner{grid-template-columns:minmax(0,1fr) auto;gap:24px}}
    .tz-panel{background:linear-gradient(120deg,var(--purple) 0%,var(--navy) 100%);border-radius:var(--radius);padding:30px;color:#fff;position:relative;overflow:hidden;margin-top:20px}
    .tz-panel::after{content:"";position:absolute;width:90px;height:90px;right:-30px;bottom:-30px;border:2px solid rgba(235,184,30,.4);transform:rotate(15deg)}
    .tz-panel h3{margin:0 0 8px;color:#fff}
    .tz-panel p{margin:0 0 4px}
    .tz-panel p.muted{color:rgba(255,255,255,.7)}

    /* ── FAQ ─────────────────────────────────────────────────────────────── */
    .b-faq__list{display:grid;gap:12px}
    .b-faq__item{background:#fff;border:1px solid var(--border);border-radius:var(--radius)}
    .b-faq__item summary{display:flex;align-items:center;gap:12px;min-height:58px;padding:16px 20px;font-weight:700;cursor:pointer;list-style:none}
    .b-faq__item summary::-webkit-details-marker{display:none}
    .b-faq__item summary > span:first-child{flex:1}
    .b-faq__item summary .material-symbols-outlined{color:var(--gold);transition:transform .2s ease}
    .b-faq__item[open] summary .material-symbols-outlined{transform:rotate(180deg)}
    .b-faq__item p{margin:0;padding:16px 20px 0;color:var(--text-muted)}
    .b-faq__item p + p{padding-top:8px}
    .b-faq__item p:last-child{padding-bottom:16px}

    /* ── Сплит-панель вопросов (шестой блок, один экран) ─────────────────── */
    .b-faq__panel{display:grid;gap:32px;align-items:start}
    .b-faq__intro h2{margin-bottom:.4em}
    .b-faq__intro > p{color:var(--text-muted);margin:0 0 26px}
    .b-faq__help{padding:26px;border-radius:var(--radius);background:linear-gradient(135deg,var(--purple) 0%,var(--navy) 100%);color:#fff;position:relative;overflow:hidden}
    .b-faq__help::after{content:"";position:absolute;width:70px;height:70px;right:-24px;bottom:-24px;border:2px solid rgba(235,184,30,.4);transform:rotate(15deg)}
    .b-faq__help-title{margin:0 0 6px;font-weight:800;font-size:1.1rem}
    .b-faq__help-sub{margin:0 0 16px;color:rgba(255,255,255,.75);font-size:var(--fs-small)}
    .b-faq__help-phone{display:inline-block;font-size:1.35rem;font-weight:800;color:var(--gold);text-decoration:none;margin-bottom:18px}
    .b-faq__help .btn{width:100%}
    @media (min-width:1024px){
      .b-faq__panel{grid-template-columns:0.85fr 1.15fr;grid-template-areas:"intro list" "help list";gap:32px 56px}
      .b-faq__intro{grid-area:intro}
      .b-faq__list{grid-area:list}
      .b-faq__help{grid-area:help}
    }

    /* ── Контакты ────────────────────────────────────────────────────────── */
    .b-contacts__inner{display:grid;gap:32px;margin-top:36px}
    .b-contacts__list{margin:0 0 24px;display:grid;grid-template-columns:auto 1fr;gap:10px 18px}
    .b-contacts__list dt{color:var(--text-muted);font-size:var(--fs-small)}
    .b-contacts__list dd{margin:0;font-weight:600}
    .b-contacts__list dd a{color:inherit;text-decoration:none}
    .b-contacts__list dd a:hover{color:var(--purple)}
    .b-contacts .img-placeholder{min-height:260px}
    @media (min-width:1024px){.b-contacts__inner{grid-template-columns:1fr 1fr;align-items:start}}

    /* Форма Битрикс24 — полностью видна */
    .b24-form-wrap{max-height:none;overflow:visible}

    /* ── Карта с жёлтой меткой офиса ─────────────────────────────────────── */
    .b-map{position:relative;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);min-height:280px}
    .b-map iframe{width:100%;height:100%;border:0;display:block;min-height:280px}

    /* ── Иконки мессенджеров ─────────────────────────────────────────────── */
    .b-mess{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--purple-soft);transition:background .2s ease,transform .2s ease}
    .b-mess:hover{background:var(--purple);transform:translateY(-2px)}
    .b-mess svg{display:block}
    .b-mess-row{display:flex;gap:12px;margin-bottom:24px}
    .b-mess--text{border-radius:999px;padding:0 16px;width:auto;font-size:.72rem;font-weight:800;color:var(--purple);letter-spacing:.02em}

    /* ── Форма ───────────────────────────────────────────────────────────── */
    .b-form{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow)}
    .b-form h3{margin:0 0 18px}
    .lead-form__field{display:block;margin-bottom:14px}
    .lead-form__label{display:block;margin-bottom:6px;font-size:var(--fs-small);font-weight:600}
    .lead-form__field input,.lead-form__field textarea{display:block;width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:var(--radius-sm);background:#fff;color:var(--text);font:inherit;font-size:var(--fs-body);min-height:46px}
    .lead-form__field input:focus,.lead-form__field textarea:focus{outline:2px solid var(--purple);outline-offset:1px;border-color:var(--purple)}
    .lead-form__field textarea{min-height:110px;resize:vertical}
    .lead-form__hint{margin:6px 0 0;font-size:var(--fs-small);font-weight:400;color:var(--text-muted)}
    .lead-form__consent{display:flex;gap:10px;align-items:flex-start;margin:16px 0;font-size:var(--fs-small);font-weight:400;color:var(--text-muted)}
    .lead-form__consent input{width:20px;height:20px;flex:0 0 auto;margin:2px 0 0}
    .lead-form__row{display:grid;gap:16px}
    .lead-form__chips{display:flex;flex-wrap:wrap;gap:8px}
    .lead-form__chip{position:relative;display:inline-flex}
    .lead-form__chip input{position:absolute;opacity:0;pointer-events:none}
    .lead-form__chip span{display:inline-flex;align-items:center;min-height:44px;padding:8px 16px;border:1px solid var(--border);border-radius:999px;background:#fff;color:var(--text);font-size:var(--fs-small);font-weight:600;cursor:pointer;white-space:nowrap}
    .lead-form__chip input:checked+span{border-color:var(--purple);background:var(--purple);color:#fff}
    .lead-form__chip input:focus-visible+span{outline:2px solid var(--purple);outline-offset:2px}
    .req{color:var(--purple)}
    .b-form .btn{width:100%}
    @media(min-width:768px){
      .lead-form__row--3{grid-template-columns:repeat(3,1fr)}
      .lead-form__row--2{grid-template-columns:repeat(2,1fr)}
    }

    /* ── Подвал (светлый) ────────────────────────────────────────────────── */
    .site-footer{background:var(--surface);color:var(--text);padding:64px 0 28px;position:relative;overflow:hidden}
    .site-footer::before{content:"";position:absolute;inset:0;pointer-events:none;
      background-image:
        linear-gradient(rgba(61,14,106,.05) 1px,transparent 1px),
        linear-gradient(90deg,rgba(61,14,106,.05) 1px,transparent 1px);
      background-size:56px 56px}
    .site-footer__inner{position:relative;display:grid;gap:36px}
    .site-footer a{color:var(--purple);text-decoration:none}
    .site-footer a:hover{color:var(--purple-dark)}
    .site-footer__title{margin:0 0 12px;font-size:var(--fs-small);font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted)}
    .site-footer__brand .logo-text b{color:var(--navy)}
    .site-footer__brand .logo-text span{color:var(--text-muted)}
    .site-footer__brand img{height:44px;width:auto;display:block}
    .site-footer__brand p{margin:14px 0 0;color:var(--text-muted);font-size:var(--fs-small);max-width:46ch}
    .site-footer__col ul{list-style:none;margin:0;padding:0}
    .site-footer__col ul a{display:inline-flex;align-items:center;min-height:44px}
    .site-footer__phone{display:inline-flex;align-items:center;min-height:44px;font-weight:800;font-size:1.3rem;color:var(--purple)}
    .site-footer__addr{margin:8px 0 0;color:var(--text-muted);font-size:var(--fs-small)}
    .site-footer__social{display:flex;gap:12px;margin-top:14px}
    .site-footer__social a{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--purple-soft);color:var(--purple)}
    .site-footer__social a:hover{background:var(--purple);color:#fff}
    .site-footer__social .material-symbols-outlined{font-size:22px}
    .site-footer__bottom{position:relative;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;margin-top:44px;padding-top:22px;border-top:1px solid var(--border);color:var(--text-muted);font-size:var(--fs-small)}
    .site-footer__bottom p{margin:0}
    .site-footer__link--disabled{display:inline-flex;align-items:center;min-height:44px;color:var(--text-muted);cursor:default}
    @media (min-width:768px){.site-footer__inner{grid-template-columns:repeat(2,1fr)}}
    @media (min-width:1024px){.site-footer__inner{grid-template-columns:1.4fr 1fr 1fr 1.2fr}}

    /* ── Подвал: падающие частицы (как на обложке) ───────────────────────── */
    .site-footer__particles{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}
    .site-footer__particles span{position:absolute;top:-24px;border-radius:2px;opacity:0;animation:b-fall linear infinite}
    .site-footer__particles span:nth-child(1){left:5%;width:10px;height:10px;background:rgba(90,57,148,.35);animation-duration:13s;animation-delay:0s}
    .site-footer__particles span:nth-child(2){left:15%;width:7px;height:7px;background:rgba(235,184,30,.5);animation-duration:17s;animation-delay:2s}
    .site-footer__particles span:nth-child(3){left:28%;width:12px;height:12px;background:rgba(185,166,216,.4);animation-duration:15s;animation-delay:4s}
    .site-footer__particles span:nth-child(4){left:42%;width:6px;height:6px;background:rgba(168,198,134,.45);animation-duration:19s;animation-delay:1s}
    .site-footer__particles span:nth-child(5){left:58%;width:9px;height:9px;background:rgba(217,192,138,.45);animation-duration:14s;animation-delay:3s}
    .site-footer__particles span:nth-child(6){left:72%;width:11px;height:11px;background:rgba(90,57,148,.3);animation-duration:18s;animation-delay:5s}
    .site-footer__particles span:nth-child(7){left:85%;width:8px;height:8px;background:rgba(235,184,30,.4);animation-duration:16s;animation-delay:2.5s}
    .site-footer__particles span:nth-child(8){left:93%;width:6px;height:6px;background:rgba(185,166,216,.4);animation-duration:20s;animation-delay:4.5s}
    @keyframes b-fall{0%{transform:translateY(0) rotate(0);opacity:0}10%{opacity:.6}90%{opacity:.4}100%{transform:translateY(120vh) rotate(180deg);opacity:0}}
    @media (prefers-reduced-motion:reduce){.site-footer__particles span{animation:none;opacity:0}}

    /* ── Reveal-анимации ─────────────────────────────────────────────────── */
    html.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .45s ease,transform .45s ease}
    html.js .reveal.is-visible{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){
      html.js .reveal{opacity:1;transform:none;transition:none}
    }

    /* ═══ Страницы услуг: компоненты поверх канона главной ═══ */
    .b-breadcrumbs{padding:18px 0 0}
    .b-breadcrumbs ol{display:flex;flex-wrap:wrap;gap:4px;list-style:none;margin:0;padding:0;font-size:var(--fs-small);color:var(--text-muted)}
    .b-breadcrumbs li{display:inline-flex;align-items:center}
    .b-breadcrumbs li+li::before{content:"/";margin:0 8px;color:var(--border)}
    .b-breadcrumbs a{display:inline-flex;align-items:center;min-height:44px;color:var(--text-muted);text-decoration:none}
    .b-breadcrumbs a:hover{color:var(--purple)}
    .b-breadcrumbs [aria-current="page"]{color:var(--text);font-weight:600}

    .b-hero--service .b-hero__inner{grid-template-columns:minmax(0,1fr);gap:0}
    .b-hero--service .b-hero__lead{max-width:70ch}
    .b-hero--service .b-hero__metrics{margin-top:8px}

    .b-tasks__lead,.b-scope__lead,.b-approach__lead,.b-projects__lead{margin:12px 0 0;max-width:70ch;color:var(--text-muted)}
    .b-tasks__grid{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .role-card{display:flex;flex-direction:column;gap:12px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:26px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .role-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .role-card h3{margin:0;display:flex;align-items:center;gap:10px;font-size:1.15rem}
    .role-card h3 .material-symbols-outlined{font-size:26px;color:var(--purple)}
    .role-card__list{list-style:none;margin:0;padding:0;display:grid;gap:8px}
    .role-card__list li{position:relative;padding-left:22px;font-weight:500;font-size:1rem;color:var(--text-muted)}
    .role-card__list li::before{content:"";position:absolute;left:0;top:.6em;width:8px;height:8px;border-radius:50%;background:var(--gold)}
    .role-card__more{display:inline-flex;align-items:center;gap:6px;margin-top:auto;min-height:44px;font-weight:700;color:var(--purple);text-decoration:none}
    .role-card__more .material-symbols-outlined{font-size:20px;transition:transform .2s ease}
    .role-card__more:hover .material-symbols-outlined{transform:translateX(4px)}
    @media (min-width:768px){.b-tasks__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}}
    @media (min-width:1024px){.b-tasks__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}

    .b-projects__grid{display:grid;gap:20px;margin-top:32px;grid-template-columns:1fr}
    .proj-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .proj-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .proj-card .img-placeholder{border:0;border-bottom:1px solid var(--border);border-radius:0;min-height:170px}
    .proj-card__body{display:flex;flex-direction:column;gap:8px;padding:22px}
    .proj-card__badges{display:flex;flex-wrap:wrap;gap:8px}
    .proj-card__body h3{margin:0;font-size:1.1rem}
    .proj-card__customer{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    .proj-card__meta{display:grid;gap:4px;list-style:none;margin:4px 0 0;padding:0;font-size:var(--fs-small);color:var(--text-muted)}
    .proj-card__meta li{display:flex;align-items:center;gap:8px}
    .proj-card__meta .material-symbols-outlined{font-size:18px;color:var(--purple)}
    .badge--work{background:rgba(235,184,30,.2);color:var(--navy)}
    .badge--type{background:var(--purple-soft);color:var(--purple)}
    @media (min-width:768px){.b-projects__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media (min-width:1024px){.b-projects__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}

    .b-scope__grid{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .scope-card{display:flex;gap:16px;align-items:flex-start;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .scope-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .scope-card__num{flex:0 0 auto;min-width:2.2ch;font-size:clamp(1.9rem,1.4rem + 1.8vw,2.8rem);line-height:1;font-weight:800;color:transparent;-webkit-text-stroke:1.5px var(--purple-soft);transition:color .2s ease,-webkit-text-stroke-color .2s ease}
    .scope-card:hover .scope-card__num{color:var(--gold);-webkit-text-stroke-color:transparent}
    .scope-card p{margin:0;font-weight:500;font-size:1rem}
    @media (min-width:768px){.b-scope__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}}
    @media (min-width:1024px){.b-scope__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}

    .b-approach__grid{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .approach-card{display:flex;flex-direction:column;gap:10px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:26px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .approach-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .approach-card > .material-symbols-outlined{font-size:28px;color:var(--purple)}
    .approach-card h3{margin:0;font-size:1.15rem}
    .approach-card p{margin:0;color:var(--text-muted);font-weight:500;font-size:1rem}
    .approach-card ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}
    .approach-card li{position:relative;padding-left:20px;color:var(--text-muted);font-weight:500;font-size:1rem}
    .approach-card li::before{content:"";position:absolute;left:0;top:.6em;width:8px;height:8px;border-radius:50%;background:var(--gold)}
    @media (min-width:768px){.b-approach__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}}

    .b-steps-sec .b-steps{margin-top:32px}
    .step{display:flex;flex-direction:column;gap:12px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .step:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .step__num{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--gold);color:var(--navy);font-weight:800}
    .step__text{margin:0;font-weight:500;font-size:1rem}
    @media (min-width:1024px){.b-steps-sec .b-steps{grid-template-columns:repeat(var(--n,5),minmax(0,1fr))}}

    .b-cta{background:var(--purple-soft);color:var(--text);padding:clamp(40px,6vw,72px) 0}
    .b-cta h2{margin:0 0 8px}
    .b-cta p{color:var(--text-muted);max-width:70ch}
    .b-cta__row{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;margin-top:20px}
    .b-cta__phone{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-weight:800;font-size:1.125rem;color:var(--text);text-decoration:none}
    .b-cta__phone .material-symbols-outlined{color:var(--purple)}

    .b-others__grid{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .other-card{position:relative;display:flex;flex-direction:column;gap:10px;min-height:100%;padding:22px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);text-decoration:none;color:var(--text);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .other-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .other-card:focus-visible{outline:2px solid var(--purple);outline-offset:2px}
    .other-card__icon{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .other-card__icon .material-symbols-outlined{font-size:24px}
    .other-card__name{font-weight:700;font-size:1.0625rem;line-height:1.3}
    .other-card__desc{color:var(--text-muted);font-size:var(--fs-small)}
    .other-card__arrow{position:absolute;top:14px;right:14px;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:var(--purple-soft);color:var(--purple)}
    .other-card__arrow .material-symbols-outlined{font-size:20px}
    .other-card:hover .other-card__arrow{background:var(--purple);color:#fff}
    @media (min-width:768px){.b-others__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}
    @media (min-width:1024px){.b-others__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}

    /* Хаб «Все услуги» */
    .svc-grid{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .svc-card{position:relative;display:flex;flex-direction:column;gap:10px;padding:26px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);text-decoration:none;color:var(--text);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .svc-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .svc-card__icon{display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .svc-card__icon .material-symbols-outlined{font-size:26px}
    .svc-card h3{margin:0;font-size:1.15rem}
    .svc-card p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    .svc-card__go{display:inline-flex;align-items:center;gap:6px;margin-top:auto;padding-top:14px;font-weight:700;color:var(--purple)}
    .svc-card__go .material-symbols-outlined{font-size:20px;transition:transform .2s ease}
    .svc-card:hover .svc-card__go .material-symbols-outlined{transform:translateX(4px)}
    @media (min-width:768px){.svc-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}}
    @media (min-width:1024px){.svc-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}

    /* ── Карта объектов на странице услуги ───────────────────────────── */
    .b-map-sec__lead{margin:12px 0 0;max-width:70ch;color:var(--text-muted)}
    .b-map-sec__wrap{margin-top:28px;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;background:var(--surface)}
    .b-map-sec__canvas{width:100%;height:clamp(420px,55vh,620px);background:var(--surface)}
    .b-map-sec__bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;border-top:1px solid var(--border);background:#fff}
    .b-map-sec__hint{display:inline-flex;align-items:center;gap:8px;color:var(--text-muted);font-size:var(--fs-small)}
    .b-map-sec__hint .material-symbols-outlined{font-size:18px;color:var(--purple)}
    .b-map-sec__bar .btn{min-height:42px;padding:9px 18px}

    /* ═══ Дизайн-проход по страницам услуг ═══════════════════════════════ */

    /* Ритм и типографика секций */
    .b-sec-head{margin:0 0 38px;max-width:860px}
    .b-sec-head .sec-index{margin-bottom:14px}
    .b-sec-head h2{margin:0 0 12px;text-wrap:balance}
    .b-sec-head__lead{margin:0;color:var(--text-muted);font-size:1.05rem;line-height:1.68;max-width:68ch}
    .section{padding:clamp(56px,7vw,96px) 0}

    /* Герой: акцент в заголовке и метрики */
    .b-hero--service h1{text-wrap:balance}
    .b-hero--service h1 .accent{color:var(--purple)}
    .b-hero--service .b-hero__lead{font-size:1.1rem;line-height:1.7}
    .b-hero__metrics li{display:flex;flex-direction:column;gap:6px}
    .b-hero__metrics li .material-symbols-outlined{font-size:20px;color:var(--purple)}

    /* Карточки ролей */
    .role-card{position:relative;padding:28px;gap:14px;overflow:hidden}
    .role-card::before{content:"";position:absolute;left:0;top:0;height:3px;width:0;background:var(--gold);transition:width .35s ease}
    .role-card:hover::before{width:100%}
    .role-card__icon{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:var(--purple-soft);color:var(--purple);transition:background .22s ease,color .22s ease,transform .22s ease}
    .role-card:hover .role-card__icon{background:var(--purple);color:#fff;transform:translateY(-2px)}
    .role-card__icon .material-symbols-outlined{font-size:26px}
    .role-card h3{font-size:1.12rem;line-height:1.35}
    .role-card__list li{line-height:1.55}

    /* Что входит: нумерованные карточки */
    .scope-card{position:relative;padding:24px;gap:18px;overflow:hidden}
    .scope-card::after{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--purple);transform:scaleY(0);transform-origin:top;transition:transform .28s ease}
    .scope-card:hover::after{transform:scaleY(1)}
    .scope-card__num{font-size:clamp(2rem,1.5rem + 1.6vw,2.6rem);line-height:.95}
    .scope-card p{line-height:1.5}

    /* Подход */
    .approach-card{padding:26px;gap:12px}
    .approach-card__icon{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:var(--purple-soft);color:var(--purple);transition:background .22s ease,color .22s ease,transform .22s ease}
    .approach-card:hover .approach-card__icon{background:var(--purple);color:#fff;transform:translateY(-2px)}
    .approach-card__icon .material-symbols-outlined{font-size:26px}
    .approach-card h3{font-size:1.08rem;line-height:1.4}
    .approach-card p,.approach-card li{line-height:1.6}

    /* Этапы: конвейер с золотой линией */
    .b-flow2{position:relative;margin-top:6px}
    .b-flow2__track{position:absolute;left:22px;right:22px;top:22px;height:2px;background:var(--border);border-radius:2px;overflow:hidden}
    .b-flow2__fill{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--purple) 0%,var(--gold) 100%);transition:width 1.4s cubic-bezier(.22,.61,.36,1)}
    .b-flow2.is-filled .b-flow2__fill{width:100%}
    .b-flow2__list{position:relative;display:grid;grid-template-columns:repeat(var(--n,5),minmax(0,1fr));gap:20px;list-style:none;margin:0;padding:0}
    .b-flow2__step{display:flex;flex-direction:column;gap:16px;min-width:0}
    .b-flow2__dot{position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:#fff;border:2px solid var(--purple);color:var(--purple);font-weight:800;font-size:.95rem;box-shadow:0 0 0 6px var(--surface);transition:background .22s ease,color .22s ease,transform .22s ease}
    .b-flow2__step:hover .b-flow2__dot{background:var(--purple);color:#fff;transform:scale(1.06)}
    .b-flow2__body{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;min-height:104px;transition:border-color .22s ease,box-shadow .22s ease,transform .22s ease}
    .b-flow2__step:hover .b-flow2__body{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-flow2__body p{margin:0;font-weight:500;font-size:.98rem;line-height:1.5}

    /* CTA: градиент брендбука */
    .b-cta--grad{background:linear-gradient(120deg,var(--purple) 0%,var(--navy) 100%);color:#fff;position:relative;overflow:hidden}
    .b-cta--grad::after{content:"";position:absolute;width:140px;height:140px;right:-40px;bottom:-40px;border:2px solid rgba(235,184,30,.4);transform:rotate(15deg)}
    .b-cta--grad h2{color:#fff}
    .b-cta--grad p{color:rgba(255,255,255,.82)}
    .b-cta--grad .sec-index{color:rgba(255,255,255,.6)}
    .b-cta--grad .b-cta__phone{color:#fff}
    .b-cta--grad .b-cta__phone .material-symbols-outlined{color:var(--gold)}
    .btn--ghost-light{border-color:rgba(255,255,255,.55);color:#fff;background:transparent}
    .btn--ghost-light:hover{background:#fff;color:var(--purple);border-color:#fff}

    /* Другие услуги */
    .other-card{padding:24px;gap:12px}
    .other-card__icon{width:48px;height:48px}
    .other-card__name{font-size:1.05rem}

    /* Каскадное появление карточек */
    html.js .reveal{transition-delay:calc(var(--i,0) * 70ms)}

    /* Мобильная версия */
    @media (max-width:767px){
      .b-sec-head{margin-bottom:26px}
      .b-sec-head__lead{font-size:1rem}
      .role-card,.scope-card,.approach-card,.other-card{padding:20px}
      .b-flow2__track{left:21px;right:auto;top:0;bottom:0;width:2px;height:auto}
      .b-flow2__fill{width:100%;height:0;transition:height 1.4s cubic-bezier(.22,.61,.36,1)}
      .b-flow2.is-filled .b-flow2__fill{height:100%}
      .b-flow2__list{grid-template-columns:1fr;gap:14px}
      .b-flow2__step{flex-direction:row;gap:14px;align-items:flex-start}
      .b-flow2__dot{flex:0 0 auto;box-shadow:0 0 0 5px var(--surface)}
      .b-flow2__body{min-height:0;flex:1 1 auto;padding:14px 16px}
      .b-cta--grad .b-cta__row{gap:10px}
      .b-cta--grad .btn{width:100%;justify-content:center}
    }

    .b-scope__obj-title{margin:44px 0 0;font-size:var(--fs-h3);display:flex;align-items:center;gap:10px}
    .b-scope__obj-title::before{content:"";width:12px;height:12px;background:var(--gold);transform:rotate(45deg);flex:0 0 auto}
    .b-scope__objects{margin-top:24px}
    .b-scope__cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
    </style>
