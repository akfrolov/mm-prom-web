  <Fragment slot="tail">
    <script is:inline>
    (function(){
      'use strict';
      document.documentElement.classList.add('js');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window && !reduce) {
        var rio = new IntersectionObserver(function(entries){
          entries.forEach(function(en){
            if (!en.isIntersecting) return;
            en.target.classList.add('is-visible');
            rio.unobserve(en.target);
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(function(el){ rio.observe(el); });
      } else {
        reveals.forEach(function(el){ el.classList.add('is-visible'); });
      }
      var flows = document.querySelectorAll('.b-flow2');
      if (flows.length) {
        if ('IntersectionObserver' in window && !reduce) {
          var fio = new IntersectionObserver(function(entries){
            entries.forEach(function(en){
              if (!en.isIntersecting) return;
              en.target.classList.add('is-filled');
              fio.unobserve(en.target);
            });
          }, { threshold: 0.25 });
          flows.forEach(function(f){ fio.observe(f); });
        } else {
          flows.forEach(function(f){ f.classList.add('is-filled'); });
        }
      }
      var megaRoles = document.querySelectorAll('.mega__role');
      var megaPanels = document.querySelectorAll('.mega__services-panel');
      if (megaRoles.length && megaPanels.length) {
        megaRoles.forEach(function(role){
          role.addEventListener('mouseenter', function(){
            var r = role.getAttribute('data-role');
            megaRoles.forEach(function(x){ x.classList.remove('is-active'); });
            role.classList.add('is-active');
            megaPanels.forEach(function(p){ p.classList.toggle('is-active', p.getAttribute('data-panel') === r); });
          });
        });
      }
      var burger = document.querySelector('.site-header__burger');
      var mobileMenu = document.getElementById('mobile-menu');
      if (burger && mobileMenu) {
        burger.addEventListener('click', function(){
          var open = mobileMenu.classList.toggle('is-open');
          burger.setAttribute('aria-expanded', String(open));
          var icon = burger.querySelector('.material-symbols-outlined');
          if (icon) icon.textContent = open ? 'close' : 'menu';
        });
      }
      var mToggle = document.querySelector('.mobile-menu__toggle');
      var mSub = document.querySelector('.mobile-menu__sub');
      if (mToggle && mSub) {
        mToggle.addEventListener('click', function(){
          var open = mSub.classList.toggle('is-open');
          mToggle.classList.toggle('is-open', open);
          mToggle.setAttribute('aria-expanded', String(open));
        });
      }
      document.querySelectorAll('.mobile-menu__role').forEach(function(role){
        role.addEventListener('click', function(){
          var r = role.getAttribute('data-mrole');
          var panel = document.querySelector('.mobile-menu__services[data-mpanel="' + r + '"]');
          var open = role.classList.toggle('is-open');
          if (panel) panel.classList.toggle('is-open', open);
        });
      });
    })();
    </script>

