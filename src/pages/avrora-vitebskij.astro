---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteButton from '../components/SiteButton.astro';
---
<BaseLayout title="Аврора Витебский — индустриальный парк на Витебском проспекте | ММ Пром" description="Аврора Витебский — новый индустриальный парк на Витебском проспекте: 38 га, участки от 1 га, мощности 1–25 МВт, строительство под ключ.">
  <Fragment slot="head">
    <style is:inline>
    /* ═══════════════════════════════════════════════════════════════════════
       ММ ПРОМ — ГЛАВНАЯ СТРАНИЦА
       Дизайн по брендбуку «МИ ПРОМ ГРУППА КОМПАНИЙ» (2026):
       • тёмно-синий (доверие, профессионализм) — доминанта,
       • глубокий фиолетовый (премиальность) — акценты,
       • золотисто-жёлтый (успех) — маркеры, CTA, логотип,
       • белый (чистота, пространство),
       • фирменный мотив — геометрические квадраты (структура, порядок).
       Стиль: деловой, современный, технологичный, премиальный.
       ═══════════════════════════════════════════════════════════════════════ */

    /* ── Брендбук: рассыпанные цветные квадраты (пиксельный паттерн) ─────── */
    .brand-squares{position:absolute;pointer-events:none;z-index:1}
    .brand-squares span{position:absolute;display:block;border-radius:2px}

    /* ── Кнопки ──────────────────────────────────────────────────────────── */

    /* ── Шапка ───────────────────────────────────────────────────────────── */

    /* ── Мегаменю «Услуги» (роль → услуга) ──────────────────────────────── */

    /* ── Мобильное меню ─────────────────────────────────────────────────── */

    /* Мобильное меню: аккордеон «Услуги» по ролям */

    /* ── Герой (светлый, геометрический паттерн) ─────────────────────────── */
    .b-hero{background:linear-gradient(180deg,#fff 0%,var(--surface) 100%);color:var(--text);position:relative;overflow:hidden}
    .b-hero__glow{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(120px);opacity:.5;pointer-events:none}
    .b-hero__glow--purple{background:var(--purple-soft);top:-160px;right:-80px}
    .b-hero__glow--gold{background:rgba(235,184,30,.28);bottom:-200px;left:-100px}
    .b-hero__glow--purple{animation:b-glow-pulse 9s ease-in-out infinite}
    .b-hero__glow--gold{animation:b-glow-pulse 12s ease-in-out infinite reverse}
    @keyframes b-glow-pulse{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.18);opacity:.75}}
    .b-hero__particles{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}
    .b-hero__particles span{position:absolute;bottom:-24px;border-radius:2px;opacity:0;animation:b-rise linear infinite}
    .b-hero__particles span:nth-child(1){left:8%;width:10px;height:10px;background:rgba(90,57,148,.35);animation-duration:14s;animation-delay:0s}
    .b-hero__particles span:nth-child(2){left:22%;width:6px;height:6px;background:rgba(235,184,30,.4);animation-duration:18s;animation-delay:2s}
    .b-hero__particles span:nth-child(3){left:38%;width:12px;height:12px;background:rgba(185,166,216,.4);animation-duration:16s;animation-delay:4s}
    .b-hero__particles span:nth-child(4){left:55%;width:7px;height:7px;background:rgba(168,198,134,.4);animation-duration:20s;animation-delay:1s}
    .b-hero__particles span:nth-child(5){left:72%;width:9px;height:9px;background:rgba(217,192,138,.4);animation-duration:15s;animation-delay:3s}
    .b-hero__particles span:nth-child(6){left:88%;width:5px;height:5px;background:rgba(90,57,148,.3);animation-duration:22s;animation-delay:5s}
    @keyframes b-rise{0%{transform:translateY(0) rotate(0);opacity:0}10%{opacity:.7}90%{opacity:.5}100%{transform:translateY(-110vh) rotate(180deg);opacity:0}}
    @media (prefers-reduced-motion:reduce){
      .b-hero__glow--purple,.b-hero__glow--gold,.b-hero__particles span{animation:none}
      .b-hero__particles span{opacity:0}
    }
    .b-hero__inner{position:relative;z-index:2;display:grid;gap:40px;padding:clamp(40px,6vw,72px) 0}
    .b-hero__eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 20px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--purple)}
    .b-hero__eyebrow::before{content:"";width:34px;height:3px;border-radius:2px;background:var(--gold)}
    .b-hero h1{color:var(--navy);margin-bottom:.35em}
    .b-hero h1 .accent{color:var(--purple)}
    .b-hero__lead{color:var(--text-muted);max-width:56ch;font-size:1.08em}
    .b-hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin:20px 0 28px}
    .b-hero__metrics{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:22px 18px}
    .b-hero__metrics li{border-top:3px solid var(--gold);padding-top:14px}
    .b-hero__metrics strong{display:block;font-size:clamp(1.1rem,1rem + .6vw,1.5rem);color:var(--purple);font-weight:800;white-space:nowrap}
    .b-hero__metrics span{display:block;color:var(--text-muted);font-size:var(--fs-small)}
    .b-hero__media{min-width:0;position:relative}
    .b-hero__media-frame{padding:3px;background:linear-gradient(135deg,var(--gold) 0%,var(--purple) 100%);position:relative;overflow:hidden;border-radius:0}
    .b-hero__media-frame .img-placeholder{width:100%;aspect-ratio:16/9;border:0;border-radius:0;background:var(--surface);color:var(--text-muted)}
    .b-hero__video{position:absolute;top:3px;left:3px;width:calc(100% - 6px);height:calc(100% - 6px);object-fit:cover;display:block}
    .b-hero__sound{position:absolute;right:16px;bottom:16px;z-index:2;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 16px;border-radius:999px;border:1px solid var(--border);background:rgba(255,255,255,.9);color:var(--navy);font:inherit;font-size:var(--fs-small);font-weight:600;cursor:pointer;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);box-shadow:0 4px 14px rgba(11,27,51,.1)}
    .b-hero__sound:hover{background:#fff}
    @media (min-width:768px){
      .b-hero{min-height:calc(100vh - var(--header-h) - var(--marquee-h));display:flex;align-items:center}
      @supports (min-height:100svh){.b-hero{min-height:calc(100svh - var(--header-h) - var(--marquee-h))}}
      .b-hero__inner{flex:1 1 auto;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
      .b-hero__metrics{grid-template-columns:repeat(2,1fr)}
      .b-hero__media{max-width:calc(100vh - var(--header-h) - var(--marquee-h) - 48px)}
    }
    @media (min-width:1024px){
      .b-hero__inner{gap:56px}
      .b-hero__metrics{grid-template-columns:repeat(4,1fr)}
      .b-hero__media-frame .img-placeholder{aspect-ratio:16/9}
    }

    /* ── Заголовки секций ────────────────────────────────────────────────── */
    .sec-index{display:inline-flex;align-items:center;gap:10px;margin:0 0 16px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted)}
    .sec-index::before{content:"";width:30px;height:3px;border-radius:2px;background:var(--gold)}
    .sec-index--light{color:rgba(255,255,255,.6)}
    .b-rowhead{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;margin-bottom:36px}
    .b-rowhead h2{margin:0}
    .b-rowhead > p{margin:0;flex-basis:100%;color:var(--text-muted)}
    .b-more{display:inline-flex;align-items:center;gap:6px;font-weight:700;text-decoration:none;color:var(--purple)}
    .b-more .material-symbols-outlined{font-size:20px;transition:transform .2s ease}
    .b-more:hover .material-symbols-outlined{transform:translateX(4px)}

    /* ── Комплексное сопровождение (шаги 01–06) ──────────────────────────── */
    .b-steps{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:1fr}
    .b-steps__item{display:flex;background:#fff;border:1px solid var(--border);border-radius:var(--radius);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-steps__item:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-steps__link{display:flex;flex:1 1 auto;gap:18px;align-items:flex-start;height:100%;padding:26px 22px;color:inherit;text-decoration:none}
    .b-steps__num{flex:0 0 auto;min-width:2.2ch;font-size:clamp(2.6rem,1.9rem + 2.8vw,3.8rem);line-height:1;font-weight:800;color:transparent;-webkit-text-stroke:1.5px var(--purple-soft);transition:color .2s ease,-webkit-text-stroke-color .2s ease}
    .b-steps__item:hover .b-steps__num{color:var(--gold);-webkit-text-stroke-color:transparent}
    .b-steps__icon{display:block;margin-bottom:8px;color:var(--purple);font-size:28px}
    .b-steps__body h3{margin:0 0 4px;font-size:1.1rem}
    .b-steps__body p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    @media (min-width:768px){.b-steps{grid-template-columns:repeat(2,1fr);gap:24px}}
    @media (min-width:1024px){.b-steps{grid-template-columns:repeat(3,1fr)}}

    /* ── Конвейер полного цикла (второй блок) ────────────────────────────── */
    .b-conveyor{position:relative}
    .b-conveyor__line{position:absolute;top:22px;left:0;right:0;height:2px;background:repeating-linear-gradient(90deg,var(--purple) 0 10px,transparent 10px 20px);opacity:.35;pointer-events:none;display:none}
    .b-conveyor__runner{position:absolute;top:18px;left:0;width:10px;height:10px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 4px rgba(235,184,30,.25);pointer-events:none;display:none}
    @keyframes b-conveyor-run{0%{left:0}100%{left:calc(100% - 10px)}}
    .b-conveyor__note{display:inline-flex;align-items:center;gap:10px;margin:28px 0 0;padding:14px 20px;border-radius:var(--radius-sm);background:var(--purple-soft);color:var(--purple);font-weight:700;font-size:var(--fs-small)}
    .b-conveyor__note .material-symbols-outlined{font-size:20px}
    /* Компактный второй блок (на один экран) */
    .b-advantages--compact{padding:clamp(32px,5vw,56px) 0}
    .b-advantages--compact h2{margin-bottom:.3em}
    .b-advantages--compact .b-advantages__lead{margin-bottom:24px}
    .b-advantages--compact .b-conveyor__note{margin-top:20px}
    /* Этап «пройден» при прохождении бегунка */
    .b-steps--conveyor .b-steps__item.is-passed .b-steps__num{color:var(--gold);-webkit-text-stroke-color:transparent}
    .b-steps--conveyor .b-steps__item.is-passed .b-steps__icon{color:var(--gold)}
    .b-steps--conveyor .b-steps__item.is-passed .b-steps__body h3{color:var(--purple)}
    @media (min-width:1024px){
      .b-conveyor__line,.b-conveyor__runner{display:block}
      .b-steps--conveyor{grid-template-columns:repeat(6,1fr);gap:14px}
      .b-steps--conveyor .b-steps__item{background:transparent;border:0;box-shadow:none}
      .b-steps--conveyor .b-steps__item:hover{transform:none;box-shadow:none}
      .b-steps--conveyor .b-steps__link{flex-direction:column;align-items:flex-start;padding:0;gap:0;height:auto}
      .b-steps--conveyor .b-steps__num{font-size:2.2rem;height:44px;display:flex;align-items:center;margin-bottom:14px}
      .b-steps--conveyor .b-steps__icon{margin-bottom:10px}
      .b-steps--conveyor .b-steps__body h3{font-size:1rem}
    }
    @media (max-width:767.98px){
      .b-steps--conveyor{position:relative;padding-left:30px}
      .b-steps--conveyor::before{content:"";position:absolute;left:6px;top:10px;bottom:10px;width:2px;background:repeating-linear-gradient(180deg,var(--purple) 0 8px,transparent 8px 16px);opacity:.35}
      .b-steps--conveyor .b-steps__item{position:relative}
      .b-steps--conveyor .b-steps__item::before{content:"";position:absolute;left:-30px;top:34px;width:14px;height:14px;border-radius:50%;background:var(--gold);border:2px solid var(--purple)}
    }

    /* ── Иконки-плашки ───────────────────────────────────────────────────── */
    .b-advantages__icon{display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:12px;background:var(--purple-soft);color:var(--purple);margin-bottom:14px}
    .b-advantages__icon .material-symbols-outlined{font-size:26px}

    /* ── Клиенты ─────────────────────────────────────────────────────────── */
    .b-clients__card{display:flex;flex-direction:column;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:26px;color:var(--text);text-decoration:none;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-clients__card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-clients__card h3{margin:0 0 6px;font-size:1.15rem}
    .b-clients__card > p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    .b-clients__go{display:inline-flex;align-items:center;gap:6px;margin-top:auto;padding-top:18px;font-weight:700;color:var(--purple)}
    .b-clients__go .material-symbols-outlined{font-size:20px;transition:transform .2s ease}
    .b-clients__card:hover .b-clients__go .material-symbols-outlined{transform:translateX(4px)}

    /* ── Комплексные решения (перечисление услуг) ────────────────────────── */
    .b-services__card{height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-services__card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-services__card h3{margin:0 0 6px;font-size:1.15rem}
    .b-services__card p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}

    /* ── Карта ролей (третий блок, один экран) ───────────────────────────── */
    .b-roles{display:grid;gap:32px;align-items:center}
    .b-roles__intro h2{margin-bottom:.4em}
    .b-roles__intro > p{color:var(--text-muted);margin:0 0 22px}
    .b-roles__hint{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:999px;background:var(--purple-soft);color:var(--purple);font-weight:700;font-size:var(--fs-small);animation:b-hint-pulse 2.2s ease-in-out infinite}
    .b-roles__hint .material-symbols-outlined{font-size:18px}
    @keyframes b-hint-pulse{
      0%,100%{box-shadow:0 0 0 0 rgba(90,57,148,.35);transform:scale(1)}
      50%{box-shadow:0 0 0 12px rgba(90,57,148,0);transform:scale(1.05)}
    }
    @media (prefers-reduced-motion:reduce){.b-roles__hint{animation:none}}
    .b-roles__grid{display:grid;gap:16px;grid-template-columns:1fr}
    .b-roles__grid .b-clients__card{padding:22px}
    .b-roles__grid .b-clients__card h3{font-size:1.1rem}
    @media (min-width:768px){
      .b-roles__grid{grid-template-columns:repeat(2,1fr);gap:20px}
    }
    @media (min-width:1024px){
      .b-roles{grid-template-columns:0.85fr 1.15fr;gap:56px}
    }

    /* ── Объекты (горизонтальная лента) ──────────────────────────────────── */
    .b-rail-group{margin-top:40px}
    .b-rail-group > h3{margin:0 0 18px;font-size:var(--fs-h3);display:flex;align-items:center;gap:10px}
    .b-rail-group > h3::before{content:"";width:12px;height:12px;background:var(--gold);transform:rotate(45deg);flex:0 0 auto}
    .b-rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:14px;scrollbar-width:thin}
    .b-rail::-webkit-scrollbar{height:6px}
    .b-rail::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
    .b-rail > *{flex:0 0 84vw;max-width:360px;scroll-snap-align:start}
    @media (min-width:768px){.b-rail{gap:20px}.b-rail > *{flex:0 0 340px}}

    .obj-card{position:relative;display:flex;flex-direction:column;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:box-shadow .2s ease,transform .2s ease}
    .obj-card:hover{box-shadow:var(--shadow);transform:translateY(-3px)}
    .obj-card .img-placeholder{border:0;border-bottom:1px solid var(--border);border-radius:0;min-height:150px;flex:1 1 auto}
    .obj-card__body{display:flex;flex-direction:column;gap:8px;padding:18px;flex:1 1 auto}
    .obj-card__badges{display:flex;align-items:center;flex-wrap:wrap;justify-content:space-between;gap:8px;min-height:24px}
    .obj-card__link{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;margin:-10px -6px -10px auto;color:var(--purple)}
    .obj-card__link .material-symbols-outlined{font-size:20px}
    .obj-card__link::after{content:"";position:absolute;inset:0}
    .obj-card__body h3{margin:0;font-size:1.1rem;line-height:1.3}
    .obj-card__desc{margin:0;font-size:var(--fs-small);color:var(--text-muted)}
    .obj-card__meta{display:grid;gap:4px;list-style:none;margin:0;padding:0;font-size:var(--fs-small);color:var(--text-muted)}
    .obj-card__meta li{display:flex;align-items:center;gap:8px}
    .obj-card__meta .material-symbols-outlined{font-size:18px;color:var(--purple)}
    .obj-card__meta .icon-loc{flex:0 0 auto}
    .obj-card__meta strong{color:var(--text);font-weight:600}
    .obj-card__presentation{position:absolute;top:12px;left:12px;z-index:2;display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:6px 12px;border:1px solid var(--border);border-radius:999px;background:#fff;color:var(--text);font-size:var(--fs-small);font-weight:600;text-decoration:none;box-shadow:0 4px 14px rgba(11,27,51,.12)}
    .obj-card__presentation .material-symbols-outlined{font-size:18px}
    .obj-card__presentation:hover{border-color:var(--purple);color:var(--purple)}
    .b-media{margin:0;display:flex;flex-direction:column;background:var(--surface)}
    .b-media img{display:block;width:100%;flex:1 1 auto;object-fit:cover}
    .b-media img.is-broken{display:none}
    .b-media figcaption{padding:8px 12px;font-size:var(--fs-small);color:var(--text-muted);border-top:1px solid var(--border)}
    .obj-card .b-media img{aspect-ratio:16/10}

    /* ── Бейджи ──────────────────────────────────────────────────────────── */
    .badge{display:inline-flex;align-items:center;gap:6px;min-height:26px;padding:3px 12px;border-radius:999px;font-size:var(--fs-small);font-weight:700}
    .badge--park,.badge--technopark{background:rgba(235,184,30,.2);color:var(--navy)}

    /* ── Заглушка изображения ────────────────────────────────────────────── */
    .img-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius);color:var(--text-muted);font-size:var(--fs-small);min-height:180px;padding:16px;text-align:center}
    .img-placeholder .material-symbols-outlined{font-size:36px;color:var(--border)}

    /* ── Стандарты строительства ─────────────────────────────────────────── */
    .b-split{display:grid;gap:24px;align-items:stretch;margin-bottom:36px}
    .b-split__media{height:100%;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
    .b-split__media img{width:100%;height:100%;object-fit:cover;aspect-ratio:4/3}
    .b-split__list{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:1fr;grid-auto-rows:1fr;height:100%}
    .b-split__item{display:flex;flex-direction:column;gap:12px;height:100%;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px}
    .b-split__item .b-advantages__icon{flex:0 0 auto;margin:0}
    .b-split__item h3{margin:0 0 4px;font-size:1.15rem}
    .b-split__item p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    @media (min-width:768px){.b-split{gap:32px}.b-split__list{grid-template-columns:repeat(2,1fr)}}
    @media (min-width:1024px){.b-split{grid-template-columns:1fr 1fr}}

    /* ── Стандарты: изображение слева + диаграмма контроля справа ────────── */
    .b-standards{display:grid;gap:24px}
    .b-standards__media{border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
    .b-standards__media img{width:100%;object-fit:cover;aspect-ratio:4/3}
    @media (min-width:768px) and (max-width:1023.98px){.b-standards__media img{aspect-ratio:16/9}}

    /* ── Диаграмма контроля (блок «Стандарты строительства») ─────────────── */
    .b-control{display:grid;grid-template-columns:1fr;gap:16px;margin-top:8px}
    .b-control__lines,.b-control__center{display:none}
    .b-control__node{position:static;width:auto;transform:none;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease}
    .b-control__node:hover{border-color:var(--purple);box-shadow:var(--shadow)}
