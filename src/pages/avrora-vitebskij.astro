.mp{border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;background:#fff;margin-top:28px}
.mp__stage{position:relative;overflow:hidden;background:var(--surface);cursor:grab;touch-action:none;height:clamp(320px,52vh,560px);display:flex;align-items:center;justify-content:center}
