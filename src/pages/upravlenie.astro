---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteButton from '../components/SiteButton.astro';
import { Image } from 'astro:assets';
import ImgHero from '../assets/images/upravlenie/upravlenie-hero.webp';
import ImgAerial from '../assets/images/upravlenie/upravlenie-aerial.webp';
import ImgHall from '../assets/images/upravlenie/upravlenie-hall.webp';
import ImgCrane from '../assets/images/upravlenie/upravlenie-crane.webp';
---
<BaseLayout title="Управляющая компания «ММ ПРОМ» — управление промышленной недвижимостью" description="Управляющая компания «ММ ПРОМ»: эксплуатация и управление промышленной недвижимостью в Санкт-Петербурге и Ленобласти. Аудит объекта, работа с арендаторами, инженерные системы, юридическое сопровождение — система единого окна.">
  <Fragment slot="head">
    <style is:inline>
    /* ═══════════════════════════════════════════════════════════════════════
       ММ ПРОМ — УПРАВЛЯЮЩАЯ КОМПАНИЯ
       Дизайн по брендбуку «МИ ПРОМ ГРУППА КОМПАНИЙ» (2026):
       • тёмно-синий (доверие, профессионализм) — доминанта,
       • глубокий фиолетовый (премиальность) — акценты,
       • золотисто-жёлтый (успех) — маркеры, CTA, логотип,
       • белый (чистота, пространство),
       • фирменный мотив — геометрические квадраты (структура, порядок).
       ═══════════════════════════════════════════════════════════════════════ */

    /* ── Герой (светлый, геометрический паттерн) ─────────────────────────── */
    .b-hero{background:linear-gradient(180deg,#fff 0%,var(--surface) 100%);color:var(--text);position:relative;overflow:hidden}
    .b-hero__glow{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(120px);opacity:.5;pointer-events:none}
    .b-hero__glow--purple{background:var(--purple-soft);top:-160px;right:-80px}
    .b-hero__glow--gold{background:rgba(235,184,30,.28);bottom:-200px;left:-100px}
    .b-hero__glow--purple{animation:b-glow-pulse 9s ease-in-out infinite}
    .b-hero__glow--gold{animation:b-glow-pulse 12s ease-in-out infinite reverse}
    @keyframes b-glow-pulse{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.18);opacity:.75}}
    .b-hero__particles{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}
    .b-hero__particles span{position:absolute;bottom:-24px;border-radius:2px;opacity:0;animation:b-rise linear infinite}
    .b-hero__particles span:nth-child(1){left:8%;width:10px;height:10px;background:rgba(90,57,148,.35);animation-duration:14s;animation-delay:0s}
    .b-hero__particles span:nth-child(2){left:22%;width:6px;height:6px;background:rgba(235,184,30,.4);animation-duration:18s;animation-delay:2s}
    .b-hero__particles span:nth-child(3){left:38%;width:12px;height:12px;background:rgba(185,166,216,.4);animation-duration:16s;animation-delay:4s}
    .b-hero__particles span:nth-child(4){left:55%;width:7px;height:7px;background:rgba(168,198,134,.4);animation-duration:20s;animation-delay:1s}
    .b-hero__particles span:nth-child(5){left:72%;width:9px;height:9px;background:rgba(217,192,138,.4);animation-duration:15s;animation-delay:3s}
    .b-hero__particles span:nth-child(6){left:88%;width:5px;height:5px;background:rgba(90,57,148,.3);animation-duration:22s;animation-delay:5s}
    @keyframes b-rise{0%{transform:translateY(0) rotate(0);opacity:0}10%{opacity:.7}90%{opacity:.5}100%{transform:translateY(-110vh) rotate(180deg);opacity:0}}
    @media (prefers-reduced-motion:reduce){
      .b-hero__glow--purple,.b-hero__glow--gold,.b-hero__particles span{animation:none}
      .b-hero__particles span{opacity:0}
    }
    .b-hero__inner{position:relative;z-index:2;display:grid;gap:40px;padding-block:clamp(40px,6vw,72px)}
    .b-hero__eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 20px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--purple)}
    .b-hero__eyebrow::before{content:"";width:34px;height:3px;border-radius:2px;background:var(--gold)}
    .b-hero h1{color:var(--navy);margin-bottom:.35em;text-wrap:balance}
    .b-hero h1 .accent{color:var(--purple)}
    .b-hero__lead{color:var(--text-muted);max-width:56ch;font-size:1.1rem;line-height:1.7}
    .b-hero__lead--sub{margin-top:-4px}
    .b-hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0 28px}
    .b-hero__metrics{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:22px 18px}
    .b-hero__metrics li{border-top:3px solid var(--gold);padding-top:14px;display:flex;flex-direction:column;gap:6px}
    .b-hero__metrics li .material-symbols-outlined{font-size:26px;color:var(--purple)}
    .b-hero__metrics span{display:block;color:var(--text-muted);font-size:var(--fs-small)}
    .b-hero__media{min-width:0;position:relative}
    .b-hero__media-frame{padding:3px;background:linear-gradient(135deg,var(--gold) 0%,var(--purple) 100%);position:relative;overflow:hidden;border-radius:0}
    .b-hero__media-frame img{display:block;width:100%;height:100%;object-fit:cover;aspect-ratio:4/3}
    @media (min-width:768px){
      .b-hero{min-height:calc(100vh - var(--header-h) - var(--marquee-h));display:flex;align-items:center}
      @supports (min-height:100svh){.b-hero{min-height:calc(100svh - var(--header-h) - var(--marquee-h))}}
      .b-hero__inner{flex:1 1 auto}
      .b-hero__metrics{grid-template-columns:repeat(4,1fr)}
    }
    @media (min-width:1024px){
      .b-hero__inner{grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:56px;align-items:center}
      .b-hero__media{max-width:calc(100vh - var(--header-h) - var(--marquee-h) - 48px)}
      .b-hero__media-frame img{aspect-ratio:16/11}
    }
    @media (max-width:1023.98px){
      .b-hero__media-frame img{aspect-ratio:16/9;max-height:400px}
    }
    @media (max-width:639.98px){
      .b-hero__actions{flex-direction:column}
      .b-hero__actions .btn{width:100%}
    }

    /* ── Заголовки и общий ритм секций ───────────────────────────────────── */
    .section{padding:clamp(56px,7vw,96px) 0}
    .b-sec-head{margin:0 0 38px;max-width:860px}
    .b-sec-head h2{margin:0 0 12px;text-wrap:balance}
    .b-sec-head__lead{margin:0;color:var(--text-muted);font-size:1.05rem;line-height:1.68;max-width:68ch}
    .sec-index{display:inline-flex;align-items:center;gap:10px;margin:0 0 14px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted)}
    .sec-index::before{content:"";width:30px;height:3px;border-radius:2px;background:var(--gold)}
    .b-sec-head__lead strong{color:var(--text);font-weight:700}

    /* ── Цитата-плашка ───────────────────────────────────────────────────── */
    .quote-card{margin:22px 0 0;background:linear-gradient(120deg,var(--purple) 0%,var(--navy) 100%);color:#fff;border-radius:var(--radius);padding:clamp(24px,3vw,34px);position:relative;overflow:hidden;font-weight:700;font-size:clamp(1.02rem,.98rem + .3vw,1.2rem);line-height:1.5}
    .quote-card::after{content:"";position:absolute;width:90px;height:90px;right:-34px;bottom:-34px;border:2px solid rgba(235,184,30,.45);transform:rotate(15deg);pointer-events:none}
    .quote-card p{margin:0}
    .quote-card p+p{margin-top:10px;font-weight:500;font-size:.95rem;color:rgba(255,255,255,.8)}
    .quote-card--soft{background:var(--purple-soft);color:var(--purple);font-size:clamp(1rem,.95rem + .2vw,1.1rem)}
    .quote-card--soft::after{border-color:rgba(90,57,148,.25)}
    .quote-card--soft p+p{color:var(--text-muted)}

    /* ── Две колонки: текст + изображение ────────────────────────────────── */
    .b-two{display:grid;gap:28px;align-items:center}
    .b-two__media{margin:0;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);min-width:0}
    .b-two__media img{display:block;width:100%;height:100%;object-fit:cover;aspect-ratio:4/3}
    .b-two__body p{line-height:1.7}
    .b-two__body p:last-child{margin-bottom:0}
    @media (min-width:1024px){
      .b-two{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:52px}
      .b-two--reverse .b-two__media{order:2}
    }

    /* ── Система потерь: замкнутый круг ──────────────────────────────────── */
    .b-loss__grid{display:grid;gap:28px;align-items:center}
    .b-loss__intro p{line-height:1.7}
    .b-cycle{list-style:none;margin:0 auto;padding:0;display:grid;gap:12px;width:100%;max-width:560px}
    .b-cycle li{background:var(--purple-soft);border:1px solid transparent;border-radius:var(--radius-sm);padding:14px 16px;color:var(--purple);font-weight:700;line-height:1.35;display:flex;align-items:center;gap:10px}
    .b-cycle li::before{counter-increment:cyc;content:counter(cyc);flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:var(--gold);color:var(--navy);font-size:.8rem;font-weight:800}
    .b-cycle{counter-reset:cyc}
    .b-cycle .b-cycle__center{display:none}
    @media (min-width:640px) and (max-width:1199.98px){
      .b-cycle{grid-template-columns:repeat(2,1fr)}
      .b-cycle .b-cycle__center{grid-column:1/-1}
    }
    @media (min-width:1200px){
      .b-loss__grid{grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:56px}
      .b-cycle{position:relative;display:block;aspect-ratio:1;max-width:560px}
      .b-cycle::before{content:"";position:absolute;inset:16%;border:2px dashed rgba(90,57,148,.28);border-radius:50%}
      .b-cycle .b-cycle__center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:34%;aspect-ratio:1;border-radius:50%;background:linear-gradient(135deg,var(--purple) 0%,var(--navy) 100%);color:#fff;text-align:center;padding:14px;box-shadow:0 18px 44px rgba(90,57,148,.28)}
      .b-cycle__center strong{font-size:.98rem;font-weight:800;line-height:1.25}
      .b-cycle__center span{font-size:var(--fs-small);color:rgba(255,255,255,.75)}
      .b-cycle li{position:absolute;width:28%;justify-content:center;text-align:center;transform:translate(-50%,-50%);background:#fff;border-color:var(--border);box-shadow:0 6px 20px rgba(11,27,51,.06)}
      .b-cycle li::before{display:none}
      .b-cycle li:nth-child(1){left:50%;top:10%}
      .b-cycle li:nth-child(2){left:86%;top:31%}
      .b-cycle li:nth-child(3){left:86%;top:69%}
      .b-cycle li:nth-child(4){left:50%;top:90%}
      .b-cycle li:nth-child(5){left:14%;top:69%}
      .b-cycle li:nth-child(6){left:14%;top:31%}
    }

    /* ── Подход: три опоры ───────────────────────────────────────────────── */
    .b-pillars{list-style:none;margin:0;padding:0;display:grid;gap:14px}
    .b-pillar{display:flex;flex-direction:column;gap:6px;background:#fff;border:1px solid var(--border);border-left:4px solid var(--gold);border-radius:var(--radius);padding:22px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-pillar:hover{border-color:var(--purple);border-left-color:var(--gold);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-pillar h3{margin:0;font-size:1.25rem;color:var(--purple);letter-spacing:-.01em}
    .b-pillar p{margin:0;color:var(--text-muted);line-height:1.6}
    .b-pillar__num{font-size:var(--fs-small);font-weight:800;letter-spacing:.14em;color:var(--gold-deep)}
    .b-approach__closing{margin:28px 0 0;font-weight:700;font-size:1.08rem;line-height:1.55}

    /* ── Шаги 01–03 ──────────────────────────────────────────────────────── */
    .step-head{display:grid;gap:22px;align-items:start;margin-bottom:32px}
    .step-head__badge{display:inline-flex;align-items:center;gap:10px;font-size:var(--fs-small);font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--purple)}
    .step-head__badge span{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--purple);color:#fff;font-size:.85rem;letter-spacing:0}
    .step-head h2{margin:0;text-wrap:balance}
    .step-head__lead{margin:0;color:var(--text-muted);font-size:1.05rem;line-height:1.68;max-width:68ch}
    @media (min-width:1024px){
      .step-head{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:52px;align-items:end;margin-bottom:40px}
    }

    /* ── Держать в руках: выгоды и контроль ──────────────────────────────── */
    .b-benefits{list-style:none;margin:0;padding:0;display:grid;gap:14px;grid-template-columns:1fr}
    .b-benefit{background:#fff;border:1px solid var(--border);border-top:3px solid var(--gold);border-radius:var(--radius);padding:20px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-benefit:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-benefit .material-symbols-outlined{font-size:26px;color:var(--purple);margin-bottom:10px}
    .b-benefit h3{margin:0 0 6px;font-size:1.05rem}
    .b-benefit p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.6}
    .b-archive{list-style:none;margin:0;padding:0;display:grid;gap:14px;grid-template-columns:1fr}
    .b-archive .b-benefit{height:100%}
    @media (min-width:640px){.b-benefits{grid-template-columns:repeat(2,1fr)}.b-archive{grid-template-columns:repeat(2,1fr)}}
    @media (min-width:1024px){.b-benefits{grid-template-columns:repeat(4,1fr);gap:16px}}
    .b-controls{list-style:none;margin:18px 0 0;padding:0;display:grid;gap:12px}
    .b-controls li{display:flex;gap:12px;align-items:flex-start;background:var(--purple-soft);border-radius:var(--radius-sm);padding:14px 18px}
    .b-controls .material-symbols-outlined{color:var(--purple);font-size:22px;flex:0 0 auto}
    .b-controls strong{display:block;color:var(--text)}
    .b-controls span{color:var(--text-muted);font-size:var(--fs-small)}
    .b-bigline{margin:28px 0 0;font-size:clamp(1.15rem,1.05rem + .5vw,1.45rem);font-weight:800;line-height:1.4;color:var(--purple);text-wrap:balance}

    /* ── Вести: дорожная карта ───────────────────────────────────────────── */
    .b-roadmap{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:16px;position:relative}
    .b-roadmap__item{position:relative;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:24px;display:flex;flex-direction:column;gap:8px}
    .b-roadmap__item--plan{border-color:var(--gold);background:linear-gradient(180deg,#fff 0%,rgba(235,184,30,.08) 100%)}
    .b-roadmap__label{display:inline-flex;align-self:flex-start;align-items:center;min-height:28px;padding:3px 12px;border-radius:999px;background:var(--purple-soft);color:var(--purple);font-size:var(--fs-small);font-weight:800}
    .b-roadmap__item--plan .b-roadmap__label{background:var(--gold);color:var(--navy)}
    .b-roadmap__item p{margin:0;color:var(--text-muted);line-height:1.6}
    .b-roadmap__item strong{color:var(--text);font-size:1.05rem}
    @media (min-width:900px){
      .b-roadmap{grid-template-columns:repeat(3,1fr);gap:24px}
      .b-roadmap::before{content:"";position:absolute;left:8%;right:8%;top:42px;height:2px;background:repeating-linear-gradient(90deg,var(--gold) 0 10px,transparent 10px 18px);opacity:.6;z-index:0}
      .b-roadmap__item{z-index:1}
    }

    /* ── Направления работы УК ───────────────────────────────────────────── */
    .b-directions{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:1fr}
    .b-direction{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:24px;display:flex;flex-direction:column;gap:10px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-direction:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-direction__icon{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .b-direction__icon .material-symbols-outlined{font-size:25px}
    .b-direction h3{margin:0;font-size:1.08rem}
    .b-direction p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.65}
    @media (min-width:768px){.b-directions{grid-template-columns:repeat(2,1fr);gap:20px}}
    @media (min-width:1024px){.b-directions{grid-template-columns:repeat(3,1fr)}}
    .b-directions__quote{margin:0;display:flex}
    .b-directions__quote .quote-card{margin:0;height:100%;display:flex;align-items:center}

    /* ── Работа с арендаторами ───────────────────────────────────────────── */
    .b-tenants{display:grid;gap:28px;align-items:start}
    .b-tenants__body p{line-height:1.7}
    .b-tenants__list{list-style:none;margin:0;padding:0;display:grid;gap:16px}
    .b-tenants__list li{display:grid;gap:4px;padding-left:18px;border-left:3px solid var(--gold)}
    .b-tenants__list strong{color:var(--text)}
    .b-tenants__list span{color:var(--text-muted);line-height:1.65}
    .b-risks{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:26px}
    .b-risks h3{margin:0 0 6px;font-size:1.1rem}
    .b-risks > p{margin:0;color:var(--text-muted);font-size:var(--fs-small)}
    .b-risks ul{list-style:none;margin:16px 0 20px;padding:0;display:grid;gap:12px}
    .b-risks li{display:flex;gap:10px;align-items:flex-start;font-size:var(--fs-small);line-height:1.55}
    .b-risks li .material-symbols-outlined{font-size:20px;color:var(--gold-deep);flex:0 0 auto;margin-top:1px}
    .b-risks__note{margin:0;padding-top:16px;border-top:1px solid var(--border);font-weight:700;line-height:1.5}
    @media (min-width:1024px){
      .b-tenants{grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:48px}
      .b-risks{position:sticky;top:calc(var(--header-h) + 20px)}
    }

    /* ── Экспресс-аудит ──────────────────────────────────────────────────── */
    .b-audit{display:grid;gap:32px;align-items:center}
    .b-audit__list{list-style:none;margin:0 0 18px;padding:0;display:grid;gap:10px}
    .b-audit__list li{display:flex;gap:10px;align-items:flex-start;font-weight:600}
    .b-audit__list .material-symbols-outlined{font-size:22px;color:var(--purple);flex:0 0 auto}
    .b-audit__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px}
    @media (min-width:1024px){.b-audit{grid-template-columns:minmax(0,1fr) minmax(0,.92fr);gap:52px}}

    /* ── Методика работы с объектами ─────────────────────────────────────── */
    .b-method{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:1fr}
    .b-method__item{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px;display:flex;flex-direction:column;gap:10px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .b-method__item:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .b-method__num{font-size:var(--fs-small);font-weight:800;letter-spacing:.14em;color:var(--gold-deep)}
    .b-method__item h3{margin:0;font-size:1.03rem;line-height:1.4}
    .b-method__item p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.65}
    .b-method__icon{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .b-method__icon .material-symbols-outlined{font-size:23px}
    @media (min-width:640px){.b-method{grid-template-columns:repeat(2,1fr)}}
    @media (min-width:1024px){.b-method{grid-template-columns:repeat(4,1fr)}}
    .b-method__more{margin-top:20px;display:flex;gap:12px;align-items:center;background:linear-gradient(120deg,var(--purple) 0%,var(--navy) 100%);color:#fff;border-radius:var(--radius);padding:18px 24px;font-weight:700;line-height:1.5}
    .b-method__more .material-symbols-outlined{color:var(--gold);font-size:24px;flex:0 0 auto}

    /* ── Другие услуги ───────────────────────────────────────────────────── */
    .b-others__grid{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .other-card{position:relative;display:flex;flex-direction:column;gap:10px;min-height:100%;padding:24px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);text-decoration:none;color:var(--text);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .other-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .other-card:focus-visible{outline:2px solid var(--purple);outline-offset:2px}
    .other-card__icon{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .other-card__icon .material-symbols-outlined{font-size:24px}
    .other-card__name{font-weight:700;font-size:1.05rem;line-height:1.3}
    .other-card__desc{color:var(--text-muted);font-size:var(--fs-small)}
    .other-card__arrow{position:absolute;top:14px;right:14px;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:var(--purple-soft);color:var(--purple)}
    .other-card__arrow .material-symbols-outlined{font-size:20px}
    .other-card:hover .other-card__arrow{background:var(--purple);color:#fff}
    @media (min-width:768px){.b-others__grid{grid-template-columns:repeat(2,1fr);gap:20px}}
    @media (min-width:1024px){.b-others__grid{grid-template-columns:repeat(3,1fr)}}

    /* ── Reveal-анимации ─────────────────────────────────────────────────── */
    html.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .45s ease,transform .45s ease;transition-delay:calc(var(--i,0) * 70ms)}
    html.js .reveal.is-visible{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){
      html.js .reveal{opacity:1;transform:none;transition:none}
    }
    </style>
  </Fragment>

