---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ObjectCard from '../../components/ObjectCard.astro';
import SiteButton from '../../components/SiteButton.astro';

// Страница объекта /obekt/<id>/ (SPEC object-pages, блоки B1/B2).
// Брендбуки /atlas-garazhnyj/ и /avrora-vitebskij/ — отдельные маршруты фичи
// brandbooks, на /obekt/ не попадают.
export async function getStaticPaths() {
  const objects = await getCollection('objects');
  const brandbookIds = new Set(['atlas-garazhny', 'avrora-vitebsky']);
  const pages = objects.filter((entry) => !brandbookIds.has(entry.id));

  // Похожие объекты (§8): приоритет того же типа, дозаполнение до 2 по
  // минимальной разнице areaNum (записи с null — в конце), вывод — по sort
  // коллекции в пределах групп. Решение агента — на ревью владельца (§13.4).
  const bySort = (a: CollectionEntry<'objects'>, b: CollectionEntry<'objects'>) => a.data.sort - b.data.sort;
  const areaDistance = (target: CollectionEntry<'objects'>, other: CollectionEntry<'objects'>) => {
    if (target.data.areaNum === null || other.data.areaNum === null) return Number.POSITIVE_INFINITY;
    return Math.abs(other.data.areaNum - target.data.areaNum);
  };

  return pages.map((entry) => {
    const others = objects.filter((other) => other.id !== entry.id);
    const sameType = others.filter((other) => other.data.type === entry.data.type).sort(bySort);
    const sameTypeSelected = sameType.slice(0, 2);
    const selectedIds = new Set(sameTypeSelected.map((other) => other.id));
    const rest = others
      .filter((other) => !selectedIds.has(other.id))
      .sort((a, b) => {
        const da = areaDistance(entry, a);
        const db = areaDistance(entry, b);
        if (da !== db) return da - db;
        return bySort(a, b);
      })
      .slice(0, Math.max(0, 2 - sameTypeSelected.length))
      .sort(bySort);
    return {
      params: { id: entry.id },
      props: { obj: entry, similar: [...sameTypeSelected, ...rest] },
    };
  });
}

interface Props {
  obj: CollectionEntry<'objects'>;
  similar: CollectionEntry<'objects'>[];
}

const { obj, similar } = Astro.props;
const d = obj.data;

const heroTitle = d.hero?.title ?? d.title;
const heroText = d.hero?.text;
// Фото галереи (§6): images; hero.image — главное фото, если заполнено.
const gallery = d.images ?? [];
const photos = [
  ...(d.hero?.image ? [d.hero.image] : []),
  ...gallery.filter((src) => src !== d.hero?.image),
];
const photoList = photos.length > 0 ? photos : d.image ? [d.image] : [];
const mainImage = photoList[0] ?? '';
const isMultiGallery = photoList.length > 1;
// OG-изображение объекта — первое фото галереи, иначе фото карточки (§3.2).
const ogImage = gallery[0] ?? d.image ?? undefined;
const pageTitle = `${d.title} — карточка объекта — ММ Пром`;
const pageDescription = heroText ?? d.desc;
// Ключевые параметры: площадь выводится одной плиткой, поэтому строка specs
// с площадью («Общая площадь»/«Площадь»/«Площадь участка»…) не дублируется.
// Если в ней есть уточнение («16 000 м², вакантно от 877 м²»), оно становится
// значением плитки «Площадь»; уточнения после двоеточия/запятой сохраняются.
const areaValue = d.area.trim();
const isAreaValue = (value) => {
  const v = value.trim();
  return v === areaValue || (v.startsWith(areaValue) && /^[,\s:—–-]/.test(v.slice(areaValue.length)));
};
const areaSpec = d.specs.find(([, label]) => /площад/i.test(label));
const areaSpecValue = areaSpec && isAreaValue(areaSpec[2]) ? areaSpec[2].trim() : areaValue;
const keySpecs = d.specs.filter((s) => s !== areaSpec).slice(0, 3);
const price = d.price.trim() || 'по запросу';
const placeholderText = d.placeholder ?? d.title;
const singlePhoto = photoList.length === 1;
const caption = d.media?.caption && singlePhoto ? d.media.caption : '';
const ctaTitle = d.cta?.title ?? 'Нужна консультация по объекту?';
const ctaText = d.cta?.text ?? 'Ответим по ставке, коммуникациям и срокам заезда. Покажем объект в удобное время.';
// Микроразметка: хлебные крошки + карточка объекта (адрес, гео, площадь, specs).
// Цена во всех объектах «по запросу», поэтому Offer не выводим.
const siteUrl = Astro.site ?? new URL('https://mm-prom.ru');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLdImage = new URL(ogImage ?? '/mmprom-logo.png', siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', siteUrl).href },
        { '@type': 'ListItem', position: 2, name: 'Каталог', item: new URL('/katalog/', siteUrl).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: canonicalUrl },
      ],
    },
    {
      '@type': 'RealEstateListing',
      name: d.title,
      description: pageDescription,
      url: canonicalUrl,
      image: [jsonLdImage],
      about: {
        '@type': 'Place',
        name: d.title,
        address: {
          '@type': 'PostalAddress',
          streetAddress: d.address,
          addressLocality: d.location === 'spb' ? 'Санкт-Петербург' : d.district,
          addressRegion: d.location === 'spb' ? 'Санкт-Петербург' : 'Ленинградская область',
          addressCountry: 'RU',
        },
        geo: { '@type': 'GeoCoordinates', latitude: d.coords[0], longitude: d.coords[1] },
        ...(d.areaNum
          ? { floorSize: { '@type': 'QuantitativeValue', value: d.areaNum, unitCode: 'MTK' } }
          : {}),
      },
      additionalProperty: d.specs.map(([, name, value]) => ({ '@type': 'PropertyValue', name, value })),
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/object-card.css?v=6">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <style is:inline>
    /* ═══════════════════════════════════════════════════════════════════════
       ММ ПРОМ — карточка объекта /obekt/<id>/ (SPEC object-pages, блок B1)
       Токены — из base.css (navy/purple/gold, Manrope+Inter).
       ═══════════════════════════════════════════════════════════════════════ */

    /* ── Каркас: контент + sticky-колонка CTA ───────────────────────────── */
    body{padding-bottom:72px}
    .object-shell{margin-top:8px;padding-bottom:48px}
    .object-main{min-width:0}
    .object-main>section{margin:0 0 40px}
    @media (min-width:1024px){
      body{padding-bottom:0}
      .object-shell{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:40px;align-items:start}
      .object-aside{position:sticky;top:88px}
    }

    /* ── Чипы типа и статуса (канон object-card) ────────────────────────── */
    .badge{display:inline-flex;align-items:center;gap:6px;min-height:26px;padding:3px 12px;border-radius:999px;font-size:var(--fs-small);font-weight:700}
    .badge--park{background:rgba(235,184,30,.18);color:var(--navy)}
    .badge--production{background:rgba(90,57,148,.12);color:var(--purple)}
    .badge--warehouse{background:rgba(14,0,40,.10);color:var(--navy)}
    .badge--land{background:#F7F5FA;border:1px solid var(--gold);color:var(--navy)}
    .badge--busy{background:rgba(14,0,40,.72);color:#fff}
    /* Сделки — теги как в каталоге (badge--deal-* в katalog.astro) */
    .badge--deal-rent{background:rgba(90,57,148,.92);color:#fff}
    .badge--deal-sale{background:rgba(235,184,30,.95);color:var(--navy)}

    /* ── Заглушка изображения ───────────────────────────────────────────── */
    .img-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius);color:var(--text-muted);font-size:var(--fs-small);min-height:180px;padding:16px;text-align:center}
    .img-placeholder .material-symbols-outlined{font-size:36px;color:var(--border)}

    /* ── Первый экран: главное фото (ветки «одно фото»/«нет фото») ──────── */
    .gallery-media{position:relative;min-height:260px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
    .gallery-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .gallery-media img.is-broken{display:none}
    .gallery-media .img-placeholder{position:absolute;inset:0;min-height:0;border:0;border-radius:0;background:transparent}
    .gallery-caption{margin:8px 0 0;font-size:var(--fs-small);color:var(--text-muted)}
    @media (min-width:768px){.gallery-media{min-height:380px}}
    @media (min-width:1024px){.gallery-media{min-height:440px}}

    /* ── Галерея: лента превью (ветка «мульти-галерея») ─────────────────── */
    .gallery-thumbs{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:8px}
    .gallery-thumb{display:block;padding:0;background:#fff;border:2px solid var(--border);border-radius:var(--radius-sm);overflow:hidden;cursor:pointer;transition:border-color .18s ease}
    .gallery-thumb img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}
    .gallery-thumb:hover{border-color:var(--purple)}
    .gallery-thumb[aria-pressed="true"]{border-color:var(--purple)}
    .gallery-thumb:focus-visible{outline:2px solid var(--purple);outline-offset:2px}
    @media (min-width:768px){.gallery-thumbs{grid-template-columns:repeat(5,1fr)}}
    @media (prefers-reduced-motion:reduce){
      .gallery-thumb,.b-similar .obj-card,.b-similar .obj-card *{transition:none}
    }

    /* ── Заголовок объекта ──────────────────────────────────────────────── */
    .b-object-head h1{margin:8px 0}
    .obj-head__badges{display:flex;flex-wrap:wrap;gap:6px}
    .obj-head__meta{margin:0 0 8px;font-size:var(--fs-small);color:var(--text-muted)}
    .obj-head__desc{margin:0;max-width:72ch;color:var(--text-muted)}

    /* ── Ключевые параметры ─────────────────────────────────────────────── */
    .b-price{padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius)}
    .b-price h2{font-size:var(--fs-h3);margin:0 0 12px}
    .price-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px 16px;margin:0}
    .price-item{min-width:0}
    .price-item dt{display:flex;align-items:center;gap:6px;font-size:var(--fs-small);color:var(--text-muted)}
    .price-item dt .material-symbols-outlined{font-size:18px;color:var(--purple)}
    .price-item dd{margin:0;font-weight:800;font-size:1.0625rem;line-height:1.35}
    .b-note{margin:14px 0 0;padding:10px 14px;background:rgba(235,184,30,.12);border-left:3px solid var(--gold);border-radius:0 var(--radius-sm) var(--radius-sm) 0;font-size:var(--fs-small);color:var(--text-muted)}
    @media (max-width:479px){.price-grid{grid-template-columns:1fr}}
    @media (min-width:1280px){.price-grid{grid-template-columns:repeat(3,1fr)}}

    /* ── Характеристики: таблица → карточки-пары на смартфоне ───────────── */
    .b-specs h2,.b-about h2{margin:0 0 12px}
    .table-wrap{background:#fff;border:1px solid var(--border);border-radius:var(--radius)}
    .specs-table{width:100%;border-collapse:collapse}
    .specs-table th,.specs-table td{padding:12px 16px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}
    .specs-table tr:last-child th,.specs-table tr:last-child td{border-bottom:0}
    .specs-table th{width:44%;font-weight:600;color:var(--text-muted)}
    @media (max-width:767px){
      .table-wrap{background:transparent;border:0;border-radius:0}
      .specs-table{display:block}
      .specs-table tbody{display:grid;gap:8px}
      .specs-table tr{display:block;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:4px 16px}
      .specs-table th,.specs-table td{display:block;width:auto;padding:6px 0;border:0}
      .specs-table td{font-weight:700}
    }

    /* ── Описание ───────────────────────────────────────────────────────── */
    .b-about p{margin:0;max-width:72ch;color:var(--text-muted)}

    /* ── Расположение: карта во всю ширину контентной колонки ───────────── */
    .b-location h2,.b-similar h2{margin:0 0 12px}
    .obj-map-canvas{position:relative;min-height:320px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
    @media (min-width:768px){.obj-map-canvas{min-height:420px}}
    @media (min-width:1024px){.obj-map-canvas{min-height:480px}}

    /* ── Похожие объекты ────────────────────────────────────────────────── */
    .b-similar{padding:24px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius)}
    .b-similar__grid{margin:0}
    .b-similar__more{margin-top:20px}
    @media (max-width:767px){.b-similar{padding:16px}}

    /* ── CTA-панель: sticky справа (≥1024) / фиксированный бар снизу ────── */
    .b-cta-panel{margin:0}
    .cta-card{display:none;padding:20px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}
    .cta-card h2{font-size:var(--fs-h3);margin:0 0 6px}
    .cta-card__text{margin:0 0 12px;font-size:var(--fs-small);color:var(--text-muted)}
    .cta-form{display:grid;gap:8px;margin:0 0 12px}
    .cta-form .btn{width:100%}
    .cta-card__phone{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-weight:700;color:var(--text);text-decoration:none}
    .cta-card__phone .material-symbols-outlined{color:var(--purple)}
    .cta-card__phone:hover{color:var(--purple)}
    .cta-bar{position:fixed;left:0;right:0;bottom:0;z-index:45;display:flex;gap:8px;padding:10px 16px;padding-bottom:calc(10px + env(safe-area-inset-bottom,0px));background:#fff;border-top:1px solid var(--border);box-shadow:0 -4px 16px rgba(11,27,51,.12)}
    .cta-bar .btn{flex:1 1 auto;padding:12px 8px;font-size:0.9375rem}
    @media (min-width:1024px){
      .cta-card{display:block}
      .cta-bar{display:none}
    }
    </style>
  </Fragment>

  <!-- Хлебные крошки: компонент Breadcrumbs (site-pages), якорь #breadcrumbs -->
  <Breadcrumbs
    items={[
      { href: '/', label: 'Главная' },
      { href: '/katalog/', label: 'Каталог' },
      { label: d.title },
    ]}
  />

  <div class="container object-shell">
    <div class="object-main">
      <section id="gallery" class="b-gallery" aria-label="Фото объекта">
        <div class="gallery-media">
          <div class="img-placeholder" aria-hidden={mainImage ? 'true' : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">image</span>
            <span>{placeholderText}</span>
          </div>
          {mainImage && (
            <img
              src={mainImage}
              alt={d.title}
              loading="eager"
              onerror="this.classList.add('is-broken');var ph=this.parentNode.querySelector('.img-placeholder');if(ph){ph.removeAttribute('aria-hidden');}"
            />
          )}
        </div>
        {isMultiGallery && (
          <div class="gallery-thumbs" role="group" aria-label="Превью галереи">
            {photoList.map((_, i) => (
              <button
                class="gallery-thumb"
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-label={`${d.title} — фото ${i + 1}`}
                data-index={i}
              >
                <img src={photoList[i]} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
        {caption && <p class="gallery-caption">{caption}</p>}
      </section>

      <section id="object-head" class="b-object-head">
        <div class="obj-head__badges">
          <span class={`badge badge--${d.type}`}>{d.typeLabel}</span>
          {d.deal.map((label) => <span class={`badge badge--deal-${label === 'Аренда' ? 'rent' : 'sale'}`}>{label}</span>)}
          {d.busy && <span class="badge badge--busy">Нет площадей</span>}
        </div>
        <h1>{heroTitle}</h1>
        <p class="obj-head__meta">{d.address} · {d.district}</p>
        <p class="obj-head__desc">{d.desc}</p>
      </section>

      <section id="key-params" class="b-price">
        <h2>Ключевые параметры</h2>
        <dl class="price-grid">
          {keySpecs.map(([icon, label, value]) => (
            <div class="price-item">
              <dt><span class="material-symbols-outlined" aria-hidden="true">{icon}</span>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
          <div class="price-item">
            <dt><span class="material-symbols-outlined" aria-hidden="true">square_foot</span>Площадь</dt>
            <dd>{areaSpecValue}</dd>
          </div>
          <div class="price-item">
            <dt><span class="material-symbols-outlined" aria-hidden="true">payments</span>Цена</dt>
            <dd>{price}</dd>
          </div>
        </dl>
        {d.busy && <p class="b-note">Нет свободных площадей</p>}
      </section>

      <section id="specs" class="b-specs">
        <h2>Характеристики</h2>
        <div class="table-wrap">
          <table class="specs-table">
            <tbody>
              {d.specs.map(([, label, value]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {heroText && (
        <section id="about" class="b-about">
          <h2>Об объекте</h2>
          <p>{heroText}</p>
        </section>
      )}

      <section id="location" class="b-location">
        <h2>Расположение на карте</h2>
        <div id="obj-map-canvas" class="obj-map-canvas" role="region" aria-label={`Карта: ${d.address}`}></div>
      </section>

      <section id="similar" class="b-similar section--tint" aria-labelledby="similar-title">
        <h2 id="similar-title">Похожие объекты</h2>
        <div class="grid grid--2 b-similar__grid">
          {similar.map((item) => <ObjectCard obj={item} showMap={false} />)}
        </div>
        <div class="b-similar__more">
          <a class="btn btn--outline" href="/katalog/">Смотреть все объекты</a>
        </div>
      </section>
    </div>

    <aside class="object-aside">
      <section id="cta" class="b-cta-panel" aria-label="Заявка по объекту">
        <div class="cta-card">
          <h2>{ctaTitle}</h2>
          <p class="cta-card__text">{ctaText}</p>
          <div class="cta-form">
            <SiteButton variant="gold" b24="request">Получить консультацию</SiteButton>
            {d.cta?.href && d.cta?.label && (
              <a class="btn btn--outline" href={d.cta.href}>{d.cta.label}</a>
            )}
          </div>
          <a class="cta-card__phone" href="tel:88003331010">
            <span class="material-symbols-outlined" aria-hidden="true">call</span>8 800 333 10 10
          </a>
        </div>

        <div class="cta-bar">
          <SiteButton variant="gold" b24="request">Получить консультацию</SiteButton>
          <a class="btn btn--outline" href="tel:88003331010">Позвонить</a>
        </div>
      </section>
    </aside>
  </div>

  <Fragment slot="tail">
    <script is:inline src="https://api-maps.yandex.ru/2.1/?apikey=2ae53810-6967-43df-9165-4003eeb71cbf&amp;lang=ru_RU&amp;ver=2.1.0"></script>
    <script is:inline define:vars={{ galleryPhotos: photoList }}>
      (function () {
        var photos = galleryPhotos || [];
        document.addEventListener('DOMContentLoaded', function () {
          var section = document.getElementById('gallery');
          if (!section) return;
          var main = section.querySelector('.gallery-media img');
          var thumbs = section.querySelectorAll('.gallery-thumb');
          if (!main || !thumbs.length) return;
          Array.prototype.forEach.call(thumbs, function (btn) {
            btn.addEventListener('click', function () {
              var src = photos[Number(btn.getAttribute('data-index'))];
              if (!src) return;
              main.classList.remove('is-broken');
              main.src = src;
              Array.prototype.forEach.call(thumbs, function (other) {
                other.setAttribute('aria-pressed', other === btn ? 'true' : 'false');
              });
            });
          });
        });
      })();
    </script>
    <script is:inline define:vars={{ coords: d.coords, mapTitle: d.title, mapAddress: d.address }}>
      (function () {
        var el = document.getElementById('obj-map-canvas');
        if (!el) return;
        var PIN = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="36" height="44" viewBox="0 0 36 44"><path d="M18 1C9.2 1 2 8.1 2 16.9 2 28 18 43 18 43s16-15 16-26.1C34 8.1 26.8 1 18 1z" fill="#5A3994" stroke="#ffffff" stroke-width="2"/><circle cx="18" cy="17" r="6" fill="#EBB81E"/></svg>');
        var visible = !('IntersectionObserver' in window);
        var started = false;
        function start() {
          if (!visible || started || !window.ymaps) return;
          started = true;
          ymaps.ready(function () {
            var center = [coords[0], coords[1]];
            var map = new ymaps.Map('obj-map-canvas', {
              center: center,
              zoom: 14,
              controls: ['zoomControl', 'fullscreenControl']
            }, { suppressMapOpenBlock: true });
            var placemark = new ymaps.Placemark(center, {
              hintContent: mapTitle,
              balloonContent: mapTitle + '<br>' + mapAddress
            }, {
              iconLayout: 'default#image',
              iconImageHref: PIN,
