  if (!el) return;
  var started = false;
  var MAX_FIT_ZOOM = 15;
  var PINS = [{"coords": [59.846744, 30.441623], "title": "Атлас Гаражный", "sub": "Гаражный проезд, 1", "main": true}, {"coords": [59.8487, 30.4577], "title": "Метро «Обухово»", "sub": "15 минут пешком"}, {"coords": [59.845301, 30.457701], "title": "5 минут до КАД", "sub": ""}, {"coords": [59.843589, 30.435506], "title": "25 минут до центра", "sub": "Петербург"}];
  function labelLayout(pin){
    var cls = pin.main ? 'ymap-label ymap-label--main' : 'ymap-label';
    var html = '<div class="'+cls+'"><span class="ymap-label__dot"></span><span class="ymap-label__body"><b>'+pin.title+'</b>'+(pin.sub?'<i>'+pin.sub+'</i>':'')+'</span></div>';
    return ymaps.templateLayoutFactory.createClass(html);
  }
  function start(){
    if (started) return;
    if (!window.mmEnsureYmaps) {
      document.addEventListener('DOMContentLoaded', start, { once: true });
      return;
    }
    started = true;
    window.mmEnsureYmaps(function(){
      var map = new ymaps.Map('atlas-map-canvas', {
        center: [59.846, 30.447], zoom: 14, controls: ['zoomControl','fullscreenControl']
      }, { suppressMapOpenBlock: true });
      map.behaviors.enable('scrollZoom');
      PINS.forEach(function(pin){
        var pm = new ymaps.Placemark(pin.coords, {
          hintContent: pin.title,
          balloonContentHeader: pin.title,
          balloonContentBody: pin.sub || ''
        }, {
          iconLayout: labelLayout(pin),
          iconShape: { type: 'Rectangle', coordinates: [[-10,-10],[10,10]] }
        });
        map.geoObjects.add(pm);
      });
      if (PINS.length > 1) {
        var bounds = ymaps.geoQuery(map.geoObjects).getBounds();
        if (bounds) {
          map.setBounds(bounds, { checkZoomRange: true, zoomMargin: 60 }).then(function(){
            if (map.getZoom() > MAX_FIT_ZOOM) map.setZoom(MAX_FIT_ZOOM);
          });
        }
      }
    });
  }
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if (e.isIntersecting) { start(); io.disconnect(); } }); }, { rootMargin: '250px' });
    io.observe(el);
  } else { start(); }
})();


(function(){
  function makeZoom(stage, img, scaleEl, minS, maxS){
    var scale = 1, tx = 0, ty = 0, dragging = false, sx = 0, sy = 0, stx = 0, sty = 0;
    function apply(){
      img.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
      if (scaleEl) scaleEl.textContent = Math.round(scale * 100) + '%';
    }
    function clamp(){
      var vw = stage.clientWidth, vh = stage.clientHeight;
      var iw = img.clientWidth * scale, ih = img.clientHeight * scale;
      var mx = Math.max(0, (iw - vw) / 2), my = Math.max(0, (ih - vh) / 2);
      tx = Math.min(mx, Math.max(-mx, tx));
      ty = Math.min(my, Math.max(-my, ty));
    }
    function zoomAt(factor, cx, cy){
      var r = stage.getBoundingClientRect();
      var px = (cx === undefined ? r.width / 2 : cx - r.left);
      var py = (cy === undefined ? r.height / 2 : cy - r.top);
      var ns = Math.min(maxS, Math.max(minS, scale * factor));
      if (ns === scale) return;
      var ratio = ns / scale;
      tx = px - (px - tx) * ratio;
      ty = py - (py - ty) * ratio;
      scale = ns;
      clamp(); apply();
    }
    function reset(){ scale = 1; tx = 0; ty = 0; apply(); }
    stage.addEventListener('wheel', function(e){
      e.preventDefault();
      zoomAt(e.deltaY < 0 ? 1.15 : 1/1.15, e.clientX, e.clientY);
    }, { passive: false });
    stage.addEventListener('mousedown', function(e){
      if (scale <= 1.001) return;
      dragging = true; sx = e.clientX; sy = e.clientY; stx = tx; sty = ty;
      stage.classList.add('is-dragging'); e.preventDefault();
    });
    window.addEventListener('mousemove', function(e){
      if (!dragging) return;
      tx = stx + (e.clientX - sx); ty = sty + (e.clientY - sy);
      clamp(); apply();
    });
    window.addEventListener('mouseup', function(){
      if (!dragging) return;
      dragging = false; stage.classList.remove('is-dragging');
    });
    var touch = null;
    stage.addEventListener('touchstart', function(e){
      if (e.touches.length === 1) touch = { x: e.touches[0].clientX, y: e.touches[0].clientY, tx: tx, ty: ty };
    }, { passive: true });
    stage.addEventListener('touchmove', function(e){
      if (e.touches.length === 1 && touch) {
        tx = touch.tx + (e.touches[0].clientX - touch.x);
        ty = touch.ty + (e.touches[0].clientY - touch.y);
        clamp(); apply();
      }
    }, { passive: true });
    stage.addEventListener('touchend', function(){ touch = null; }, { passive: true });
    return { zoomIn: function(){ zoomAt(1.25); }, zoomOut: function(){ zoomAt(1/1.25); }, reset: reset };
  }

  var mp = document.querySelector('[data-mp]');
  if (mp) {
    var stage = mp.querySelector('[data-mp-stage]');
    var img = mp.querySelector('.mp__img');
    var scaleEl = mp.querySelector('[data-mp-scale]');
    var z = makeZoom(stage, img, scaleEl, 1, 6);
    mp.querySelector('[data-mp-in]').addEventListener('click', z.zoomIn);
    mp.querySelector('[data-mp-out]').addEventListener('click', z.zoomOut);
    mp.querySelector('[data-mp-reset]').addEventListener('click', z.reset);
  }

  var lb = document.querySelector('[data-mp-lightbox]');
  var expand = document.querySelector('[data-mp-expand]');
  if (lb && expand) {
    var lbStage = lb.querySelector('[data-mp-lb-stage]');
    var lbImg = lb.querySelector('.mp-lightbox__img');
    var lbScale = lb.querySelector('[data-mp-lb-scale]');
    var lz = makeZoom(lbStage, lbImg, lbScale, 0.5, 8);
    function open(){
      lb.classList.add('is-open'); lb.setAttribute('aria-hidden','false');
      document.body.style.overflow = 'hidden'; lz.reset();
    }
    function close(){
      lb.classList.remove('is-open'); lb.setAttribute('aria-hidden','true');
      document.body.style.overflow = '';
    }
    expand.addEventListener('click', open);
    lb.querySelectorAll('[data-mp-close]').forEach(function(el){ el.addEventListener('click', close); });
    lb.querySelector('[data-mp-lb-in]').addEventListener('click', lz.zoomIn);
    lb.querySelector('[data-mp-lb-out]').addEventListener('click', lz.zoomOut);
    lb.querySelector('[data-mp-lb-reset]').addEventListener('click', lz.reset);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && lb.classList.contains('is-open')) close(); });
  }
})();
    </script>

