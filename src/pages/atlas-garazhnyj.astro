.mp__controls{display:flex;align-items:center;gap:6px}
.mp__btn{display:inline-flex;align-items:center;justify-content:center;min-width:40px;height:40px;padding:0 12px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text);font:inherit;font-weight:700;cursor:pointer;transition:border-color .2s ease,color .2s ease,background .2s ease}
.mp__btn:hover{border-color:var(--purple);color:var(--purple)}
.mp__btn--reset{font-size:var(--fs-small);font-weight:600}
.mp__scale{min-width:52px;text-align:center;font-size:var(--fs-small);font-weight:700;color:var(--text-muted);font-variant-numeric:tabular-nums}

.mp-lightbox{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;padding:24px}
.mp-lightbox.is-open{display:flex}
.mp-lightbox__overlay{position:absolute;inset:0;background:rgba(14,0,40,.82);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.mp-lightbox__content{position:relative;z-index:1;width:min(1200px,96vw);height:min(88vh,900px);display:flex;flex-direction:column;background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.4)}
.mp-lightbox__close{position:absolute;top:10px;right:10px;z-index:3;width:44px;height:44px;border:0;border-radius:50%;background:rgba(255,255,255,.92);color:var(--text);font-size:1.6rem;line-height:1;cursor:pointer}
.mp-lightbox__close:hover{background:var(--purple);color:#fff}
.mp-lightbox__toolbar{display:flex;align-items:center;gap:6px;padding:10px 14px;border-bottom:1px solid var(--border);background:#fff}
.mp-lightbox__stage{position:relative;flex:1 1 auto;overflow:hidden;background:var(--surface);cursor:grab;touch-action:none;display:flex;align-items:center;justify-content:center}
.mp-lightbox__stage.is-dragging{cursor:grabbing}
.mp-lightbox__img{max-width:100%;max-height:100%;width:auto;height:auto;transform-origin:center center;will-change:transform;user-select:none;-webkit-user-drag:none}

