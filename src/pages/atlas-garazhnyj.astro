.obj-contact{display:grid;gap:28px;grid-template-columns:1fr;align-items:center}
.obj-contact__media{margin:0;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);background:var(--surface)}
.obj-contact__media img{display:block;width:100%;height:100%;max-height:440px;object-fit:cover}
.obj-contact__body h2{margin:0 0 10px}
