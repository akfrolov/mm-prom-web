    <script is:inline>
    (function(){
      'use strict';
      document.documentElement.classList.add('js');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var counters = document.querySelectorAll('[data-count]');
      if (counters.length && 'IntersectionObserver' in window && !reduce) {
        var cio = new IntersectionObserver(function(entries){
          entries.forEach(function(en){
            if (!en.isIntersecting) return;
            cio.unobserve(en.target);
            var el = en.target;
            var target = parseInt(el.getAttribute('data-count'), 10) || 0;
            var suffix = el.getAttribute('data-suffix') || '';
            var dur = 1200;
            var t0 = performance.now();
            var tick = function(t){
              var p = Math.min(1, (t - t0) / dur);
              var v = Math.round(target * (1 - Math.pow(1 - p, 3)));
              el.textContent = v.toLocaleString('ru-RU') + suffix;
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        }, { threshold: 0.5 });
        counters.forEach(function(el){ cio.observe(el); });
      }

      var reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window && !reduce) {
        var rio = new IntersectionObserver(function(entries){
          entries.forEach(function(en){
            if (!en.isIntersecting) return;
            en.target.classList.add('is-visible');
            rio.unobserve(en.target);
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(function(el){ rio.observe(el); });
      } else {
        reveals.forEach(function(el){ el.classList.add('is-visible'); });
      }

      var video = document.querySelector('.b-hero__video');
      var soundBtn = document.querySelector('.b-hero__sound');
      if (video && soundBtn) {
        soundBtn.addEventListener('click', function(){
          video.muted = !video.muted;
          soundBtn.setAttribute('aria-pressed', String(!video.muted));
          var label = soundBtn.querySelector('.b-hero__sound-label');
          var icon = soundBtn.querySelector('.material-symbols-outlined');
          if (label) label.textContent = video.muted ? 'Со звуком' : 'Выключить звук';
          if (icon) icon.textContent = video.muted ? 'volume_up' : 'volume_off';
          if (!video.muted && video.paused) { var p = video.play(); if (p && p.catch) p.catch(function(){}); }
        });
      }

      /* Конвейер: бегунок отмечает этапы как пройденные */
      var conveyor = document.querySelector('.b-conveyor');
      var runner = document.querySelector('.b-conveyor__runner');
      var steps = document.querySelectorAll('.b-steps--conveyor .b-steps__item');
      var desktop = window.matchMedia && window.matchMedia('(min-width:1024px)');
      if (conveyor && runner && steps.length && desktop && desktop.matches && !reduce) {
        var duration = 9000;
        var t0 = performance.now();
        var tick = function(t){
          var p = ((t - t0) % duration) / duration;
          var convRect = conveyor.getBoundingClientRect();
          var x = p * (convRect.width - runner.offsetWidth);
          runner.style.left = x + 'px';
          steps.forEach(function(step){
            var r = step.getBoundingClientRect();
            var center = r.left - convRect.left + r.width / 2;
            if (x >= center) step.classList.add('is-passed');
            else step.classList.remove('is-passed');
          });
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

    })();
    </script>

