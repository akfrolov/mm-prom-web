.mp{border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;background:#fff;margin-top:28px}
.mp__stage{position:relative;overflow:hidden;background:var(--surface);cursor:grab;touch-action:none;height:clamp(320px,52vh,560px);display:flex;align-items:center;justify-content:center}
.mp__stage.is-dragging{cursor:grabbing}
.mp__img{max-width:100%;max-height:100%;width:auto;height:auto;transform-origin:center center;will-change:transform;user-select:none;-webkit-user-drag:none}
.mp__bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-top:1px solid var(--border);background:#fff}
.mp__hint{display:inline-flex;align-items:center;gap:8px;margin:0;color:var(--text-muted);font-size:var(--fs-small)}
