---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteButton from '../components/SiteButton.astro';
import { Image } from 'astro:assets';
import ImgAtlas from '../assets/images/about/atlas-garazhny.webp';
import ImgProductionComplex from '../assets/images/about/production-complex.webp';
import ImgRedevelopment from '../assets/images/about/redevelopment-complex.webp';
import ImgAntaresAerial from '../assets/images/about/antares-aerial.webp';
import ImgAtlasAerial from '../assets/images/about/atlas-garazhny-aerial.webp';
import ImgAntaresBefore from '../assets/images/about/antares-before.webp';
import ImgAntaresAfter from '../assets/images/about/antares-after.webp';
import ImgBrokerageSale from '../assets/images/about/brokerage-sale.webp';
import ImgBrokerageRent from '../assets/images/about/brokerage-rent.webp';
import ImgBuildToSuit from '../assets/images/about/build-to-suit.webp';
---
<BaseLayout title="О компании — ММ Пром" description="ММ Пром — девелопер и оператор индустриальной недвижимости Санкт-Петербурга и Ленинградской области: с 2011 года, 38 га индустриальных территорий, 25+ проектов, 150+ компаний-резидентов.">
  <Fragment slot="head">
    <style is:inline>
    /* ═══════════════════════════════════════════════════════════════════════
       ММ ПРОМ — О КОМПАНИИ
       Дизайн по брендбуку «МИ ПРОМ ГРУППА КОМПАНИЙ» (2026):
       • тёмно-синий (доверие, профессионализм) — доминанта,
       • глубокий фиолетовый (премиальность) — акценты,
       • золотисто-жёлтый (успех) — маркеры, CTA, логотип,
       • белый (чистота, пространство),
       • фирменный мотив — геометрические квадраты (структура, порядок).
       ═══════════════════════════════════════════════════════════════════════ */

    /* ── Герой (светлый, геометрический паттерн) ─────────────────────────── */
    .b-hero{background:linear-gradient(180deg,#fff 0%,var(--surface) 100%);color:var(--text);position:relative;overflow:hidden}
    .b-hero__glow{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(120px);opacity:.5;pointer-events:none}
    .b-hero__glow--purple{background:var(--purple-soft);top:-160px;right:-80px}
    .b-hero__glow--gold{background:rgba(235,184,30,.28);bottom:-200px;left:-100px}
    .b-hero__glow--purple{animation:b-glow-pulse 9s ease-in-out infinite}
    .b-hero__glow--gold{animation:b-glow-pulse 12s ease-in-out infinite reverse}
    @keyframes b-glow-pulse{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.18);opacity:.75}}
    .b-hero__particles{position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden}
    .b-hero__particles span{position:absolute;bottom:-24px;border-radius:2px;opacity:0;animation:b-rise linear infinite}
    .b-hero__particles span:nth-child(1){left:8%;width:10px;height:10px;background:rgba(90,57,148,.35);animation-duration:14s;animation-delay:0s}
    .b-hero__particles span:nth-child(2){left:22%;width:6px;height:6px;background:rgba(235,184,30,.4);animation-duration:18s;animation-delay:2s}
    .b-hero__particles span:nth-child(3){left:38%;width:12px;height:12px;background:rgba(185,166,216,.4);animation-duration:16s;animation-delay:4s}
    .b-hero__particles span:nth-child(4){left:55%;width:7px;height:7px;background:rgba(168,198,134,.4);animation-duration:20s;animation-delay:1s}
    .b-hero__particles span:nth-child(5){left:72%;width:9px;height:9px;background:rgba(217,192,138,.4);animation-duration:15s;animation-delay:3s}
    .b-hero__particles span:nth-child(6){left:88%;width:5px;height:5px;background:rgba(90,57,148,.3);animation-duration:22s;animation-delay:5s}
    @keyframes b-rise{0%{transform:translateY(0) rotate(0);opacity:0}10%{opacity:.7}90%{opacity:.5}100%{transform:translateY(-110vh) rotate(180deg);opacity:0}}
    @media (prefers-reduced-motion:reduce){
      .b-hero__glow--purple,.b-hero__glow--gold,.b-hero__particles span{animation:none}
      .b-hero__particles span{opacity:0}
    }
    .b-hero__inner{position:relative;z-index:2;display:grid;gap:40px;padding-block:clamp(40px,6vw,72px)}
    .b-hero__eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 20px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--purple)}
    .b-hero__eyebrow::before{content:"";width:34px;height:3px;border-radius:2px;background:var(--gold)}
    .b-hero h1{color:var(--navy);margin-bottom:.35em}
    .b-hero h1 .accent{color:var(--purple)}
    .b-hero__lead{color:var(--text-muted);max-width:56ch;font-size:1.08em}
    .b-hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin:20px 0 28px}
    .b-hero__media{min-width:0;position:relative}
    .b-hero__media-frame{padding:3px;background:linear-gradient(135deg,var(--gold) 0%,var(--purple) 100%);position:relative;overflow:hidden;border-radius:0}
    .b-hero__video{position:absolute;top:3px;left:3px;width:calc(100% - 6px);height:calc(100% - 6px);object-fit:cover;display:block}
    .b-hero--service .b-hero__inner{grid-template-columns:minmax(0,1fr);gap:0}
    .b-hero--service .b-hero__lead{max-width:70ch}
    .b-hero.about-hero{min-height:0}
    .about-hero .b-hero__inner{grid-template-columns:minmax(0,1fr);gap:32px}
    .about-hero__media{margin:0;position:relative;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);background:var(--surface);box-shadow:var(--shadow)}
    .about-hero__media img{display:block;width:100%;height:100%;min-height:280px;max-height:520px;object-fit:cover}
    .about-hero__media img.is-broken{display:none}
    .about-hero__badge{position:absolute;left:20px;bottom:20px;display:inline-flex;align-items:center;gap:10px;padding:12px 18px;border-radius:999px;background:rgba(14,0,40,.82);color:#fff;font-size:var(--fs-small);font-weight:600;letter-spacing:.02em;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
    .about-hero__badge .material-symbols-outlined{font-size:20px;color:var(--gold)}
    @media (min-width:1024px){
      .about-hero .b-hero__inner{grid-template-columns:1.05fr .95fr;align-items:center;gap:48px}
      .about-hero__media{align-self:stretch;display:flex}
      .about-hero__media img{min-height:0;max-height:none;height:100%}
    }

    /* ── Заголовки секций ────────────────────────────────────────────────── */
    .sec-index{display:inline-flex;align-items:center;gap:10px;margin:0 0 16px;font-size:var(--fs-small);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted)}
    .sec-index::before{content:"";width:30px;height:3px;border-radius:2px;background:var(--gold)}
    .b-subhead{margin:24px 0 10px;font-size:var(--fs-h3);line-height:1.3}
    .about-lead{margin:12px 0 0;max-width:70ch;color:var(--text-muted);font-size:1.0625rem;line-height:1.7}
    .about-more{display:inline-flex;align-items:center;gap:6px;margin-top:24px;font-weight:700;text-decoration:none;color:var(--purple)}
    .about-more .material-symbols-outlined{font-size:20px;transition:transform .2s ease}
    .about-more:hover .material-symbols-outlined{transform:translateX(4px)}

    /* ── Преимущества ────────────────────────────────────────────────────── */
    .about-adv{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .adv-card{display:flex;flex-direction:column;gap:12px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:24px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .adv-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .adv-card__icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .adv-card__icon .material-symbols-outlined{font-size:24px}
    .adv-card h3{margin:0;font-size:1.1rem;line-height:1.3}
    .adv-card p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.6}
    @media (min-width:768px){.about-adv{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}
    @media (min-width:1024px){.about-adv{grid-template-columns:repeat(3,minmax(0,1fr))}}

    .about-stats{margin-top:32px;padding:28px;border-radius:var(--radius);background:linear-gradient(120deg,var(--purple) 0%,var(--navy) 100%);color:#fff;position:relative;overflow:hidden}
    .about-stats::after{content:"";position:absolute;width:110px;height:110px;right:-32px;top:-32px;border:2px solid rgba(235,184,30,.35);transform:rotate(15deg);pointer-events:none}
    .about-stats__title{margin:0 0 20px;font-weight:800;font-size:1.05rem;letter-spacing:.02em;color:#fff}
    .about-stats__grid{display:grid;gap:20px;grid-template-columns:repeat(2,minmax(0,1fr))}
    .about-stat{border-top:3px solid var(--gold);padding-top:12px}
    .about-stat strong{display:block;font-size:clamp(1.35rem,1.1rem + 1.1vw,1.9rem);line-height:1.15;color:var(--gold);font-weight:800}
    .about-stat span{display:block;margin-top:6px;color:rgba(255,255,255,.78);font-size:var(--fs-small)}
    @media (min-width:1024px){.about-stats__grid{grid-template-columns:repeat(4,minmax(0,1fr))}}

    /* ── Миссия и ценности ───────────────────────────────────────────────── */
    .about-mission{display:grid;gap:32px;margin-top:28px}
    .about-mission__text{max-width:70ch}
    .about-mission__text p{margin:0 0 1.1em;color:var(--text-muted);font-size:1.0625rem;line-height:1.75}
    .about-mission__text p:last-child{margin-bottom:0}
    .about-mission__text strong{color:var(--navy)}
    .about-values{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow-sm);align-self:start}
    .about-values h3{margin:0 0 8px}
    .about-values ul{list-style:none;margin:0;padding:0}
    .about-values li{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);font-weight:600}
    .about-values li:last-child{border-bottom:0;padding-bottom:0}
    .about-values .material-symbols-outlined{font-size:22px;color:var(--gold)}
    @media (min-width:1024px){.about-mission{grid-template-columns:1.15fr .85fr;gap:48px;align-items:start}}

    /* ── Клиенты ─────────────────────────────────────────────────────────── */
    .about-clients{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .client-card{position:relative;display:flex;flex-direction:column;gap:10px;height:100%;padding:24px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .client-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .client-card__icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .client-card__icon .material-symbols-outlined{font-size:24px}
    .client-card h3{margin:0;font-size:1.1rem;line-height:1.35}
    .client-card p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.6}
    .client-card__go{display:inline-flex;align-items:center;gap:6px;margin-top:auto;padding-top:14px;font-weight:700;font-size:var(--fs-small);color:var(--purple)}
    .client-card__go .material-symbols-outlined{font-size:18px;transition:transform .2s ease}
    .client-card:hover .client-card__go .material-symbols-outlined{transform:translateX(4px)}
    @media (min-width:768px){.about-clients{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}

    /* ── Услуги ──────────────────────────────────────────────────────────── */
    .about-services{display:grid;gap:16px;margin-top:32px;grid-template-columns:1fr}
    .service-card{position:relative;display:flex;flex-direction:column;gap:10px;height:100%;padding:24px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .service-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .service-card__icon{display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:12px;background:var(--purple-soft);color:var(--purple)}
    .service-card__icon .material-symbols-outlined{font-size:24px}
    .service-card h3{margin:0;font-size:1.1rem;line-height:1.3}
    .service-card p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.6}
    .service-card__go{display:inline-flex;align-items:center;gap:6px;margin-top:auto;padding-top:14px;font-weight:700;font-size:var(--fs-small);color:var(--purple)}
    .service-card__go .material-symbols-outlined{font-size:18px;transition:transform .2s ease}
    .service-card:hover .service-card__go .material-symbols-outlined{transform:translateX(4px)}
    @media (min-width:768px){.about-services{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}
    @media (min-width:1024px){.about-services{grid-template-columns:repeat(3,minmax(0,1fr))}}

    /* ── Этапы ───────────────────────────────────────────────────────────── */
    .about-process{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:16px;grid-template-columns:1fr}
    .about-process li{padding-top:14px;border-top:2px solid var(--gold)}
    .about-process__num{display:block;margin-bottom:6px;font-size:.8rem;font-weight:800;letter-spacing:.08em;color:var(--purple)}
    .about-process p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.6}
    @media (min-width:768px){.about-process{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}
    @media (min-width:1024px){
      .about-process--4{grid-template-columns:repeat(4,minmax(0,1fr))}
      .about-process--5,.about-process--6{grid-template-columns:repeat(3,minmax(0,1fr))}
      .about-split .about-process--6{grid-template-columns:repeat(2,minmax(0,1fr))}
    }

    .about-split{display:grid;gap:28px;margin-top:28px}
    .about-checks{list-style:none;margin:0;padding:0;display:grid;gap:12px}
    .about-checks li{position:relative;padding-left:34px;color:var(--text-muted);font-size:1rem;line-height:1.55}
    .about-checks li::before{content:"✓";position:absolute;left:0;top:.05em;display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--gold);color:var(--navy);font-size:14px;font-weight:800}
    @media (min-width:1024px){.about-split{grid-template-columns:.9fr 1.1fr;gap:48px;align-items:start}}

    /* ── Кейсы ───────────────────────────────────────────────────────────── */
    .about-cases{display:grid;gap:20px;margin-top:32px;grid-template-columns:1fr}
    .case-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
    .case-card:hover{border-color:var(--purple);box-shadow:var(--shadow);transform:translateY(-3px)}
    .case-card__media{overflow:hidden;background:var(--surface)}
    .case-card__media img{display:block;width:100%;height:100%;aspect-ratio:4/3;object-fit:cover}
    .case-card__body{display:flex;flex-direction:column;gap:10px;padding:24px}
    .case-card__body h3{margin:0;font-size:1.1rem;line-height:1.35}
    .case-card__body h3 a{color:inherit;text-decoration:none}
    .case-card__body h3 a:hover{color:var(--purple)}
    .case-card__meta{list-style:none;margin:0;padding:0;display:grid;gap:4px;font-size:var(--fs-small);color:var(--text-muted)}
    .case-card__meta li{display:flex;align-items:flex-start;gap:8px}
    .case-card__meta .material-symbols-outlined{flex:0 0 auto;font-size:18px;color:var(--purple)}
    .case-card__label{margin:0;font-weight:700;font-size:var(--fs-small);color:var(--navy)}
    .case-card__list{margin:0;padding-left:18px;display:grid;gap:4px;color:var(--text-muted);font-size:var(--fs-small);line-height:1.55}
    @media (min-width:768px){.about-cases{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media (min-width:1024px){.about-cases--3{grid-template-columns:repeat(3,minmax(0,1fr))}}

    /* ── Управление: кейс + было/стало ───────────────────────────────────── */
    .about-mgmt{display:grid;gap:24px;margin-top:32px}
    .about-mgmt .case-card{height:auto}
    .about-ba{display:grid;gap:16px;align-content:start}
    .about-ba > h3{margin:0;font-size:1.1rem;line-height:1.4}
    .ba-figure{position:relative;margin:0;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm)}
    .ba-figure img{display:block;width:100%;height:100%;aspect-ratio:4/3;object-fit:cover}
    .ba-label{position:absolute;left:14px;top:14px;padding:6px 14px;border-radius:999px;background:rgba(14,0,40,.82);color:#fff;font-size:var(--fs-small);font-weight:700;letter-spacing:.02em}
    @media (min-width:1024px){.about-mgmt{grid-template-columns:1.1fr .9fr;gap:32px;align-items:start}}

    /* ── Консалтинг и инвестиции ─────────────────────────────────────────── */
    .about-panels{display:grid;gap:20px;margin-top:28px}
    .about-case-panel{background:var(--surface);border:1px solid var(--border);border-left:5px solid var(--purple);border-radius:var(--radius);padding:26px}
    .about-case-panel__tag{display:inline-block;margin-bottom:10px;padding:4px 12px;border-radius:999px;background:var(--purple);color:#fff;font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
    .about-case-panel p{margin:0 0 .7em;color:var(--text-muted);font-size:var(--fs-small);line-height:1.65}
    .about-case-panel p:last-child{margin-bottom:0}
    .about-case-panel strong{color:var(--navy)}
    .about-case-panel .case-card__list{margin:8px 0 14px}
    .about-note{background:linear-gradient(135deg,var(--purple) 0%,var(--navy) 100%);border-radius:var(--radius);padding:28px;color:#fff;position:relative;overflow:hidden}
    .about-note::after{content:"";position:absolute;width:90px;height:90px;right:-30px;bottom:-30px;border:2px solid rgba(235,184,30,.4);transform:rotate(15deg)}
    .about-note h3{margin:0 0 12px;color:#fff}
    .about-note p{margin:0;color:rgba(255,255,255,.84);line-height:1.7}
    @media (min-width:1024px){.about-panels{grid-template-columns:1.2fr .8fr;gap:28px;align-items:start}}

    .about-invest{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:26px;margin-top:28px}
    .about-invest > p{margin:0 0 1em;color:var(--text-muted);line-height:1.7}
    .about-invest > p:last-of-type{margin-bottom:0}
    .invest-solution{margin:22px 0 0}
    .invest-solution h3{margin:0 0 14px}
    .invest-steps{list-style:none;margin:0 0 24px;padding:0;display:grid;gap:14px}
    .invest-step{display:flex;gap:14px;align-items:flex-start}
    .invest-step__num{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:32px;height:32px;border-radius:50%;background:var(--gold);color:var(--navy);font-weight:800;font-size:.85rem}
    .invest-step p{margin:0;color:var(--text-muted);line-height:1.65}
    .invest-step strong{color:var(--navy)}
    .invest-models{display:grid;gap:14px}
    .invest-model{background:#fff;border:1px solid var(--border);border-radius:var(--radius-sm);padding:20px}
    .invest-model h4{margin:0 0 6px;font-size:1rem;color:var(--purple)}
    .invest-model p{margin:0;color:var(--text-muted);font-size:var(--fs-small);line-height:1.6}
    @media (min-width:768px){.invest-models{grid-template-columns:repeat(2,minmax(0,1fr))}}

    /* ── Партнёры ────────────────────────────────────────────────────────── */
    .partners__grid{display:grid;gap:16px;margin-top:32px;grid-template-columns:repeat(2,minmax(0,1fr))}
    .partner{display:flex;align-items:center;justify-content:center;min-height:140px;padding:24px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);transition:border-color .2s ease,box-shadow .2s ease}
    .partner:hover{border-color:var(--purple);box-shadow:var(--shadow)}
    .partner img{max-width:100%;max-height:80px;width:auto;height:auto;transition:transform .2s ease}
    .partner:hover img{transform:scale(1.04)}
    .partner img.is-broken{display:none}
    .partner__fallback{display:none;color:var(--text-muted);font-size:var(--fs-small);text-align:center}
    .partner img.is-broken + .partner__fallback{display:block}
    @media (min-width:768px){
      .partners__grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
      .partner{min-height:176px;padding:26px}
      .partner img{max-height:110px}
    }
    @media (min-width:1024px){
      .partner{min-height:208px;padding:30px}
      .partner img{max-height:128px}
    }

    /* ── Reveal-анимации ─────────────────────────────────────────────────── */
    html.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .45s ease,transform .45s ease}
    html.js .reveal.is-visible{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){
