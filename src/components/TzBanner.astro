---
import SiteButton from './SiteButton.astro';

interface Props {
  heading?: string;
  text?: string;
  muted?: string;
  ctaHref?: string;
  ctaText?: string;
  ctaB24?: string;
  ctaB24Loader?: string;
}

const { heading, text, muted, ctaHref, ctaText, ctaB24, ctaB24Loader } = Astro.props;
---

<div class="grid grid--2 b-tz-banner">
  <div>
    <slot name="before" />
    {heading && <h3>{heading}</h3>}
    {text && <p style="font-weight:600">{text}</p>}
    {muted && <p class="muted">{muted}</p>}
    <slot />
  </div>
  {ctaText && ctaB24 && ctaB24Loader && (
    <>
      <script is:inline define:vars={{ ctaB24Loader }} data-b24-form={ctaB24} data-skip-moving="true">(function(d,u){var s=d.createElement('script');s.async=true;s.src=u+'?'+(Date.now()/180000|0);var h=d.getElementsByTagName('script')[0];h.parentNode.insertBefore(s,h);})(document,ctaB24Loader);</script>
      <button class="btn btn--gold b-tz-banner__cta" type="button" data-b24-form={ctaB24} data-skip-moving="true">{ctaText}</button>
    </>
  )}
  {!ctaB24 && ctaHref && ctaText && <SiteButton variant="gold" href={ctaHref} class="b-tz-banner__cta">{ctaText}</SiteButton>}
  <slot name="aside" />
</div>
