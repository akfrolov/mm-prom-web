---
import SiteButton from './SiteButton.astro';
import B24Loader from './B24Loader.astro';
import { B24_FORMS, type B24FormKey } from '../lib/b24';

interface Props {
  heading?: string;
  text?: string;
  muted?: string;
  ctaHref?: string;
  ctaText?: string;
  b24?: B24FormKey;
}

const { heading, text, muted, ctaHref, ctaText, b24 } = Astro.props;
const b24Form = b24 ? B24_FORMS[b24] : null;
---

<div class="grid grid--2 b-tz-banner">
  <div>
    <slot name="before" />
    {heading && <h3>{heading}</h3>}
    {text && <p style="font-weight:600">{text}</p>}
    {muted && <p class="muted">{muted}</p>}
    <slot />
  </div>
  {ctaText && b24 && b24Form && (
    <>
      <B24Loader form={b24} />
      <button class="btn btn--gold b-tz-banner__cta" type="button" data-b24-form={b24Form.id} data-b24-form-telemetry-sign={b24Form.sign} data-b24-loader={b24Form.loader}>{ctaText}</button>
    </>
  )}
  {!b24Form && ctaHref && ctaText && <SiteButton variant="gold" href={ctaHref} class="b-tz-banner__cta">{ctaText}</SiteButton>}
  <slot name="aside" />
</div>
