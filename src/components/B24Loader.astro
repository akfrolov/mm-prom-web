---
import { B24_FORMS, type B24FormKey } from '../lib/b24';

interface Props {
  form: B24FormKey;
}

const { form } = Astro.props;
const b24Form = B24_FORMS[form];
---

<script
  is:inline
  data-b24-form={b24Form.id}
  data-b24-form-telemetry-sign={b24Form.sign}
  data-b24-loader={b24Form.loader}
  data-skip-moving="true"
></script>
