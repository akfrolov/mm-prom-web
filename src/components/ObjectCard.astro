---
import type { CollectionEntry } from 'astro:content';
import { B24_FORMS } from '../lib/b24';
import B24Loader from './B24Loader.astro';

interface Props {
  obj: CollectionEntry<'objects'>;
  stagger?: number;
  showMap?: boolean;
}

const { obj, stagger, showMap = false } = Astro.props;
const d = obj.data;
const brandbookRoutes: Record<string, string> = {
  'atlas-garazhny': '/atlas-garazhnyj/',
  'avrora-vitebsky': '/avrora-vitebskij/',
};
const href = brandbookRoutes[obj.id] ?? `/obekt/${obj.id}/`;
const isBrandbook = obj.id in brandbookRoutes;
const searchTitle = d.searchTitle ?? d.title.toLowerCase();
const presentationForm = B24_FORMS.contact;
const cardMedia = d.media ?? (d.image ? { src: d.image, alt: d.title, caption: '' } : null);
---

{showMap ? (
  <article
    class={`obj-card obj-card--cat reveal${d.busy ? ' obj-card--busy' : ''}`}
    data-id={obj.id}
    data-type={d.type}
    data-deal={d.dealTypes.join(' ')}
    data-area={d.areaNum ?? 0}
    data-loc={d.location}
    data-title={searchTitle}
  >
    <div class="obj-card__media">
      {d.image && <img src={d.image} alt={d.title} loading="lazy" onerror="this.classList.add('is-broken')" />}
      <div class="obj-card__ph"><span class="material-symbols-outlined" aria-hidden="true">image</span>{d.title}</div>
      <div class="obj-card__badges">
        <div class="obj-card__badges-left"><span class={`badge badge--${d.type}`}>{d.typeLabel}</span></div>
        <div class="obj-card__badges-left">
          {d.deal.map((label) => <span class={`badge badge--deal-${label === 'Аренда' ? 'rent' : 'sale'}`}>{label}</span>)}
          {d.busy && <span class="badge badge--busy">Нет площадей</span>}
        </div>
      </div>
      <button class="obj-card__map" type="button" data-map={obj.id} aria-label={`Показать на карте: ${d.title}`}>
        <span class="material-symbols-outlined" aria-hidden="true">map</span>
      </button>
    </div>
    <div class="obj-card__body">
      <h3>{d.title}</h3>
      <p class="obj-card__addr"><span class="material-symbols-outlined" aria-hidden="true">place</span><span>{d.address}</span></p>
      <div class="obj-card__facts">
        <div class="obj-card__fact"><span>Площадь</span><strong>{d.area}</strong></div>
        <div class="obj-card__fact"><span>Локация</span><strong>{d.district}</strong></div>
      </div>
      <div class="obj-card__foot">
        {isBrandbook ? (
          <a class="obj-card__ext" href={href}>На страницу объекта<span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>
        ) : (
          <a class="obj-card__more" href={href}>Подробнее<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
        )}
        {d.busy && <span class="obj-card__busy"><span class="material-symbols-outlined" aria-hidden="true">info</span>Нет вакантных площадей</span>}
      </div>
    </div>
  </article>
) : (
  <article class="obj-card reveal" style={stagger !== undefined ? `--i:${stagger}` : undefined}>
    {d.presentation && (
      <Fragment>
        <B24Loader form="contact" />
        <button
          class="obj-card__presentation"
          type="button"
          aria-label={`Запросить презентацию: ${d.title}`}
          data-b24-form={presentationForm.id}
          data-b24-form-telemetry-sign={presentationForm.sign}
        >
          <span class="material-symbols-outlined" aria-hidden="true">description</span>Презентация
        </button>
      </Fragment>
    )}
    {cardMedia ? (
      <figure class="b-media">
        <img src={cardMedia.src} alt={cardMedia.alt} loading="lazy" onerror="this.classList.add('is-broken')" />
      </figure>
    ) : d.placeholder ? (
      <div class="img-placeholder" data-img={d.placeholder}>
        <span class="material-symbols-outlined" aria-hidden="true">image</span>{d.placeholder}
      </div>
    ) : null}
    <div class="obj-card__body">
      <div class="obj-card__badges">
        <span class={`badge badge--${d.type}`}>{d.typeLabel}</span>
        <a class="obj-card__link" href={href} aria-label={`Открыть страницу объекта: ${d.title}`}>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span>
        </a>
      </div>
      <h3>{d.title}</h3>
      <p class="obj-card__desc">{d.cardDesc ?? d.desc}</p>
      {d.meta && d.meta.length > 0 && (
        <ul class="obj-card__meta">
          {d.meta.map(([icon, label, value]) => (
            <li>
              <span class="material-symbols-outlined" aria-hidden="true">{icon}</span>
              <span>{label}: <strong>{value}</strong></span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </article>
)}
