---
interface Props {
  icon: string;
  title: string;
  items?: string[];
  text?: string;
  index?: number;
}

const { icon, title, items = [], text, index = 0 } = Astro.props;
---

<article class="role-card reveal" style={`--i:${index}`}>
  <span class="role-card__icon"><span class="material-symbols-outlined" aria-hidden="true">{icon}</span></span>
  <h3>{title}</h3>
  {text
    ? <p class="role-card__text">{text}</p>
    : <ul class="role-card__list">{items.map((item) => <li>{item}</li>)}</ul>}
</article>
